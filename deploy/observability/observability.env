# Settings of the optional observability profile (docs/OBSERVABILITY.md). No secrets.
# docker compose --env-file .env --env-file deploy/observability/observability.env --profile observability up --wait
# The host serves /actuator/prometheus on port 9464, which compose does not publish: only Prometheus reaches it.
# On that port /actuator/health moves too; the application port keeps the engines' API and the cockpit.
HORUS_MANAGEMENT_PORT=9464
HORUS_MANAGEMENT_EXPOSURE=health,prometheus

{
  "uid": "horus-bpm-process-engine",
  "title": "Horus BPM: Process Engine",
  "tags": [
    "horus-bpm",
    "process-engine"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Instances",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running instances",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(horus_pre_instances_active)",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Open incidents",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(horus_pre_incidents_open)",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Started in the last hour",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(horus_pre_instances_started_total[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Failed in the last hour",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(horus_pre_instances_failed_total[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Started, completed, failed per minute",
      "description": "Counters move after the transaction commits.",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(horus_pre_instances_started_total[5m]))*60",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "started"
        },
        {
          "refId": "B",
          "expr": "sum(rate(horus_pre_instances_completed_total[5m]))*60",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "completed"
        },
        {
          "refId": "C",
          "expr": "sum(rate(horus_pre_instances_failed_total[5m]))*60",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "failed"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Running instances",
      "description": "Refreshed every metrics.gauge-refresh (30 s), not per scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "horus_pre_instances_active",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "row",
      "title": "Incidents",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Incidents raised by error code (per 10 min)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (errorCode) (increase(horus_pre_incidents_raised_total[10m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "{{errorCode}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Message correlations refused (per 10 min)",
      "description": "NOT_CORRELATED: no instance waits and no process starts on it. AMBIGUOUS: two instances wait on the same key.",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(horus_pre_messages_refused_total[10m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "{{reason}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "row",
      "title": "Job queue and timers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Age of the oldest due job, by kind",
      "description": "0 when none is due. This is the task, timer and async backlog in seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (kind) (horus_pre_jobs_due_oldest_age_seconds)",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "{{kind}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Timer lag (avg, max)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(horus_pre_timer_lag_seconds_sum[5m])) / clamp_min(sum(rate(horus_pre_timer_lag_seconds_count[5m])),0.0001)",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "avg"
        },
        {
          "refId": "B",
          "expr": "max(horus_pre_timer_lag_seconds_max)",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "max"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "row",
      "title": "Steps and async work",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Step duration p50 / p99 by kind",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, stepKind) (rate(horus_pre_step_duration_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "p50 {{stepKind}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, stepKind) (rate(horus_pre_step_duration_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "p99 {{stepKind}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Steps per second by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(horus_pre_step_duration_seconds_count[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "{{outcome}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Async attempts by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, outcome) (rate(horus_pre_async_attempts_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 29,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  }
}

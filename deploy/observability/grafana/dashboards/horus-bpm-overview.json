{
  "uid": "horus-bpm-overview",
  "title": "Horus BPM: host overview",
  "tags": [
    "horus-bpm",
    "platform"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Availability and traffic",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hosts up",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"horus-bpm\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "5xx share",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])),0.001)",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Open incidents",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(horus_pre_incidents_open)",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Running instances",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(horus_pre_instances_active)",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request latency p50 / p99",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "p99"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "row",
      "title": "Database connection pool",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "pending"
        },
        {
          "refId": "D",
          "expr": "hikaricp_connections_max",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "max"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Time to acquire a connection (avg and max)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hikaricp_connections_acquire_seconds_sum[5m]) / clamp_min(rate(hikaricp_connections_acquire_seconds_count[5m]),0.0001)",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "avg"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_acquire_seconds_max",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "max"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "row",
      "title": "JVM",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Heap used",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (jvm_memory_used_bytes{area=\"heap\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "used {{instance}}"
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (jvm_memory_max_bytes{area=\"heap\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "max {{instance}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "GC pause time per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(jvm_gc_pause_seconds_sum[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Live threads",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "horus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_threads_live_threads",
          "datasource": {
            "type": "prometheus",
            "uid": "horus-prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  }
}

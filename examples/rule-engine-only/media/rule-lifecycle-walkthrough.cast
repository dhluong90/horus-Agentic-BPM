[1.507, "o", "\r\n\u001b[33m# 6. The decision row\u001b[0m\r\n"]
[1.214, "o", "\r\n\u001b[32m$\u001b[0m "]
[0.612, "o", "docker exec horus-pg psql -U horus -d horus -c 'SELECT rule_set_name, version_num, outcome, matched_rule_ids, outputs, caller_id FROM rle_decision'\r\n"]
[0.474, "o", " rule_set_name | version_num | outcome | matched_rule_ids |                  outputs                  | caller_id \r\n---------------+-------------+---------+------------------+-------------------------------------------+-----------\r\n card-fee      |           1 | OK      | [\"R1\"]           | {\"fee\": {\"amount\": 0, \"currency\": \"VND\"}} | tuan\r\n(1 row)\r\n\r\n"]

{"version": 3, "term": {"cols": 80, "rows": 24}, "timestamp": 1795136416, "command": "bash rule-lifecycle-walkthrough.sh"}
[0.008, "o", "\r\n\u001b[33m# Rule Engine example host: import, self-approval refused, second approver, evaluate, decision row\u001b[0m\r\n"]
[1.212, "o", "\r\n\u001b[33m# Start the host on the dev profile (the README command, sent to the background)\u001b[0m\r\n"]
[1.206, "o", "\r\n\u001b[32m$\u001b[0m "]
[0.611, "o", "SPRING_PROFILES_ACTIVE=dev HORUS_DB_PASSWORD=change-me HORUS_DEMO_PASSWORD=demo-only java -jar examples/rule-engine-only/target/example-rule-engine-only-*.jar > /tmp/s1d-host.log 2>&1 &\r\n"]
[0.413, "o", "\r\n"]
[2.612, "o", "\r\n\u001b[32m$\u001b[0m "]
[0.609, "o", "curl -s localhost:8080/actuator/health\r\n"]
[0.423, "o", "{\"groups\":[\"liveness\",\"readiness\"],\"status\":\"UP\"}"]
[0.000, "o", "\r\n"]
[1.508, "o", "\r\n\u001b[33m# 1. Hoa imports the card fee table\u001b[0m\r\n"]
[1.212, "o", "\r\n\u001b[32m$\u001b[0m "]
[0.608, "o", "curl -s -u hoa:demo-only -X POST localhost:8080/api/bpm/rules/v1/rule-sets -H 'Content-Type: application/yaml' -H 'Idempotency-Key: demo-import-1' --data-binary @examples/rule-engine-only/src/main/resources/rules/card-fee.yaml\r\n"]
[0.600, "o", "{\"ruleSet\":\"card-fee\",\"version\":1,\"status\":\"DRAFT\",\"hitPolicy\":\"FIRST\",\"effectiveFrom\":null,\"lockVersion\":0,\"canonicalHash\":\"596414cd75b2ef85719562ae8014a3f26bad0527ee2d6ef191377aec572f9142\",\"sourceFormat\":\"YAML\",\"sourceHash\":\"384b22bb66472be161812853f01dcc44eb3f3b79df1b18dbde14a0c3f22b5f3e\",\"requestedBy\":null,\"requestedAt\":null,\"approvedBy\":null,\"approvedAt\":null,\"createdBy\":\"hoa\",\"createdAt\":\"2026-11-20T01:00:27.617628Z\",\"definition\":{\"description\":\"Monthly card fee by tier and transaction count\",\"hitPolicy\":\"first\",\"inputs\":[{\"name\":\"tier\",\"type\":\"string\"},{\"description\":\"card transactions in the month\",\"name\":\"txCount\",\"type\":\"integer\"}],\"outputs\":[{\"name\":\"fee\",\"type\":\"money\"}],\"ruleSet\":\"card-fee\",\"rules\":[{\"id\":\"R1\",\"then\":{\"fee\":\"0 VND\"},\"when\":{\"tier\":\"== 'GOLD'\"}},{\"id\":\"R2\",\"then\":{\"fee\":\"10000 VND\"},\"when\":{\"txCount\":\">= 3\"}},{\"id\":\"R3\",\"then\":{\"fee\":\"50000 VND\"},\"when\":{}}],\"schemaVersion\":1},\"allowedActions\":[\"request-publish\"]}"]
[0.000, "o", "\r\n"]
[1.513, "o", "\r\n\u001b[33m# 2. Hoa requests publication\u001b[0m\r\n"]
[1.216, "o", "\r\n\u001b[32m$\u001b[0m "]
[0.619, "o", "curl -s -u hoa:demo-only -X POST localhost:8080/api/bpm/rules/v1/rule-sets/card-fee/versions/1:request-publish\r\n"]
[0.478, "o", "{\"ruleSet\":\"card-fee\",\"version\":1,\"status\":\"PENDING_APPROVAL\",\"hitPolicy\":\"FIRST\",\"effectiveFrom\":null,\"lockVersion\":1,\"canonicalHash\":\"596414cd75b2ef85719562ae8014a3f26bad0527ee2d6ef191377aec572f9142\",\"sourceFormat\":\"YAML\",\"sourceHash\":\"384b22bb66472be161812853f01dcc44eb3f3b79df1b18dbde14a0c3f22b5f3e\",\"requestedBy\":\"hoa\",\"requestedAt\":\"2026-11-20T01:00:31.456735Z\",\"approvedBy\":null,\"approvedAt\":null,\"createdBy\":\"hoa\",\"createdAt\":\"2026-11-20T01:00:27.617628Z\",\"definition\":{\"description\":\"Monthly card fee by tier and transaction count\",\"hitPolicy\":\"first\",\"inputs\":[{\"name\":\"tier\",\"type\":\"string\"},{\"description\":\"card transactions in the month\",\"name\":\"txCount\",\"type\":\"integer\"}],\"outputs\":[{\"name\":\"fee\",\"type\":\"money\"}],\"ruleSet\":\"card-fee\",\"rules\":[{\"id\":\"R1\",\"then\":{\"fee\":\"0 VND\"},\"when\":{\"tier\":\"== 'GOLD'\"}},{\"id\":\"R2\",\"then\":{\"fee\":\"10000 VND\"},\"when\":{\"txCount\":\">= 3\"}},{\"id\":\"R3\",\"then\":{\"fee\":\"50000 VND\"},\"when\":{}}],\"schemaVersion\":1},\"allowedActions\":[]}"]
[0.001, "o", "\r\n"]
[1.506, "o", "\r\n\u001b[33m# 3. Hoa tries to approve her own request\u001b[0m\r\n"]
[1.204, "o", "\r\n\u001b[32m$\u001b[0m "]
[0.606, "o", "curl -s -w '\\nHTTP %{http_code}\\n' -u hoa:demo-only -X POST localhost:8080/api/bpm/rules/v1/rule-sets/card-fee/versions/1:approve\r\n"]
[0.475, "o", "{\"type\":\"https://github.com/dhluong90/horus-Agentic-BPM/wiki/Common-Error-Codes#self_approval_forbidden\",\"title\":\"Forbidden\",\"status\":403,\"code\":\"SELF_APPROVAL_FORBIDDEN\",\"detail\":\"The requester or author of card-fee v1 cannot approve it\",\"correlationId\":\"01M7V7GD1M9TC14WKGB7NPKCEZ\"}\r\nHTTP 403\r\n"]
[0.001, "o", "\r\n"]
[1.513, "o", "\r\n\u001b[33m# 4. Minh approves\u001b[0m\r\n"]
[1.212, "o", "\r\n\u001b[32m$\u001b[0m "]
[0.606, "o", "curl -s -u minh:demo-only -X POST localhost:8080/api/bpm/rules/v1/rule-sets/card-fee/versions/1:approve -H 'Content-Type: application/json' -d '{\"comment\":\"Fees checked against the tariff\"}'\r\n"]
[0.523, "o", "{\"ruleSet\":\"card-fee\",\"version\":1,\"status\":\"PUBLISHED\",\"hitPolicy\":\"FIRST\",\"effectiveFrom\":\"2026-11-20T01:00:39.102630Z\",\"lockVersion\":2,\"canonicalHash\":\"596414cd75b2ef85719562ae8014a3f26bad0527ee2d6ef191377aec572f9142\",\"sourceFormat\":\"YAML\",\"sourceHash\":\"384b22bb66472be161812853f01dcc44eb3f3b79df1b18dbde14a0c3f22b5f3e\",\"requestedBy\":\"hoa\",\"requestedAt\":\"2026-11-20T01:00:31.456735Z\",\"approvedBy\":\"minh\",\"approvedAt\":\"2026-11-20T01:00:39.102630Z\",\"createdBy\":\"hoa\",\"createdAt\":\"2026-11-20T01:00:27.617628Z\",\"definition\":{\"description\":\"Monthly card fee by tier and transaction count\",\"hitPolicy\":\"first\",\"inputs\":[{\"name\":\"tier\",\"type\":\"string\"},{\"description\":\"card transactions in the month\",\"name\":\"txCount\",\"type\":\"integer\"}],\"outputs\":[{\"name\":\"fee\",\"type\":\"money\"}],\"ruleSet\":\"card-fee\",\"rules\":[{\"id\":\"R1\",\"then\":{\"fee\":\"0 VND\"},\"when\":{\"tier\":\"== 'GOLD'\"}},{\"id\":\"R2\",\"then\":{\"fee\":\"10000 VND\"},\"when\":{\"txCount\":\">= 3\"}},{\"id\":\"R3\",\"then\":{\"fee\":\"50000 VND\"},\"when\":{}}],\"schemaVersion\":1},\"allowedActions\":[]}"]
[0.000, "o", "\r\n"]
[1.513, "o", "\r\n\u001b[33m# 5. Tuan, a teller, evaluates a Gold customer\u001b[0m\r\n"]
[1.214, "o", "\r\n\u001b[32m$\u001b[0m "]
[0.613, "o", "curl -s -u tuan:demo-only -X POST localhost:8080/api/bpm/rules/v1/decisions/card-fee:evaluate -H 'Content-Type: application/json' -d '{\"inputs\":{\"tier\":\"GOLD\",\"txCount\":5}}'\r\n"]
[0.519, "o", "{\"decisionId\":\"01M7V7GMJCZR5B4QJZ2B2W08KB\",\"ruleSet\":\"card-fee\",\"version\":1,\"evaluatedAt\":\"2026-11-20T01:00:42.956297Z\",\"outcome\":\"MATCHED\",\"matched\":true,\"matchedRuleIds\":[\"R1\"],\"outputs\":{\"fee\":{\"currency\":\"VND\",\"amount\":0}}}"]

{
  "schema": {
    "type": "object",
    "required": ["amountMinor", "recommendation"],
    "properties": {
      "amountMinor": { "type": "integer", "minimum": 1 },
      "tenorMonths": { "type": "integer", "minimum": 1, "maximum": 360 },
      "recommendation": { "enum": ["APPROVE", "DECLINE"] },
      "note": { "type": "string", "maxLength": 500 }
    },
    "if": { "required": ["recommendation"], "properties": { "recommendation": { "const": "DECLINE" } } },
    "then": { "required": ["note"] }
  },
  "hints": {
    "order": ["amountMinor", "tenorMonths", "recommendation", "note"],
    "widgets": { "note": "textarea", "recommendation": "radio" },
    "labels": {
      "amountMinor": { "en": "Proposed amount (VND)", "vi": "Số tiền đề xuất (VND)" },
      "tenorMonths": { "en": "Term (months)", "vi": "Kỳ hạn (tháng)" },
      "recommendation": { "en": "Your recommendation", "vi": "Đề xuất của bạn" },
      "note": { "en": "Reason for the approver (required when declining)", "vi": "Lý do gửi người phê duyệt (bắt buộc khi từ chối)" }
    }
  }
}

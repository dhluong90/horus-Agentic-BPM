{
  "schema": {
    "type": "object",
    "required": ["decision"],
    "properties": {
      "decision": { "enum": ["APPROVED", "REJECTED"] },
      "reason": { "type": "string", "maxLength": 500 }
    },
    "if": { "required": ["decision"], "properties": { "decision": { "const": "REJECTED" } } },
    "then": { "required": ["reason"] }
  },
  "hints": {
    "order": ["decision", "reason"],
    "widgets": { "decision": "radio", "reason": "textarea" },
    "labels": {
      "decision": { "en": "Your decision (approve or reject)", "vi": "Quyết định của bạn (phê duyệt hoặc từ chối)" },
      "reason": { "en": "Reason (required when rejecting)", "vi": "Lý do (bắt buộc khi từ chối)" }
    }
  }
}

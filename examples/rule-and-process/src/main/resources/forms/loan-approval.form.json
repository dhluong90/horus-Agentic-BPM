{
  "schema": {
    "type": "object",
    "required": ["decision"],
    "properties": {
      "decision": { "enum": ["APPROVED", "REJECTED"] },
      "reason": { "type": "string", "maxLength": 500 }
    },
    "if": { "required": ["decision"], "properties": { "decision": { "const": "REJECTED" } } },
    "then": { "required": ["reason"] }
  },
  "hints": {
    "order": ["decision", "reason"],
    "widgets": { "decision": "radio", "reason": "textarea" },
    "labels": {
      "decision": { "en": "Your decision", "vi": "Quyết định của bạn" },
      "reason": { "en": "Reason (required when rejecting)", "vi": "Lý do (bắt buộc khi từ chối)" }
    },
    "options": {
      "decision": {
        "APPROVED": { "en": "Approve", "vi": "Phê duyệt" },
        "REJECTED": { "en": "Reject", "vi": "Từ chối" }
      }
    },
    "effects": {
      "decision": {
        "APPROVED": { "en": "The loan is priced and the offer is sent.", "vi": "Khoản vay được định giá và gửi đề nghị." },
        "REJECTED": { "en": "The customer is told it is declined.", "vi": "Khách hàng được báo bị từ chối." }
      }
    }
  }
}

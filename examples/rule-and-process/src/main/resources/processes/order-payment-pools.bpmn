<?xml version="1.0" encoding="UTF-8"?>
<!-- Worked example: a collaboration of three pools. The order desk and the payment desk are executable, so each is a
     definition of its own; the auditor has no process and is a black box that only receives a message. The message
     flows are kept and drawn. The engine runs a message through POST /messages:correlate, not through the flow:
     payment-requested starts the payment desk (message start), payment-received wakes the order desk by orderId.
     The user task has no assignee, so the work group comes from its lane: "Back office" gives group back-office. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:horus="urn:horus-bpm:bpmn:extensions:v1"
                  id="Definitions_order-payment-pools" targetNamespace="urn:horus-bpm:examples"
                  expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:message id="m-requested" name="payment-requested"/>
  <bpmn:message id="m-received" name="payment-received"/>
  <bpmn:message id="m-audit" name="payment-audited"/>
  <bpmn:collaboration id="order-to-cash">
    <bpmn:participant id="pool-order" name="Order desk" processRef="order-desk"/>
    <bpmn:participant id="pool-payment" name="Payment desk" processRef="payment-desk"/>
    <bpmn:participant id="pool-auditor" name="Auditor"/>
    <bpmn:messageFlow id="mf-request" name="Payment request" sourceRef="request-payment" targetRef="payment-start" messageRef="m-requested"/>
    <bpmn:messageFlow id="mf-received" name="Payment confirmed" sourceRef="report-payment" targetRef="wait-for-payment" messageRef="m-received"/>
    <bpmn:messageFlow id="mf-audit" name="Audit copy" sourceRef="audited" targetRef="pool-auditor" messageRef="m-audit"/>
  </bpmn:collaboration>
  <bpmn:process id="order-desk" name="Order desk" isExecutable="true">
    <bpmn:startEvent id="start" name="Order placed"/>
    <bpmn:sendTask id="request-payment" name="Ask the payment desk" messageRef="m-requested" horus:correlationKey="orderId"/>
    <bpmn:receiveTask id="wait-for-payment" name="Wait for the payment" messageRef="m-received" horus:correlationKey="orderId"/>
    <bpmn:endEvent id="done" name="Order paid"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="request-payment"/>
    <bpmn:sequenceFlow id="f2" sourceRef="request-payment" targetRef="wait-for-payment"/>
    <bpmn:sequenceFlow id="f3" sourceRef="wait-for-payment" targetRef="done"/>
  </bpmn:process>
  <bpmn:process id="payment-desk" name="Payment desk" isExecutable="true">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-back-office" name="Back office">
        <bpmn:flowNodeRef>confirm-payment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-treasury" name="Treasury">
        <bpmn:flowNodeRef>payment-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report-payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>audited</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="payment-start" name="Payment requested">
      <bpmn:messageEventDefinition messageRef="m-requested"/>
    </bpmn:startEvent>
    <bpmn:userTask id="confirm-payment" name="Confirm the payment" horus:resultVariable="confirmation"/>
    <bpmn:sendTask id="report-payment" name="Tell the order desk" messageRef="m-received" horus:correlationKey="orderId"/>
    <bpmn:endEvent id="audited" name="Audit copy sent" horus:correlationKey="orderId">
      <bpmn:messageEventDefinition messageRef="m-audit"/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="g1" sourceRef="payment-start" targetRef="confirm-payment"/>
    <bpmn:sequenceFlow id="g2" sourceRef="confirm-payment" targetRef="report-payment"/>
    <bpmn:sequenceFlow id="g3" sourceRef="report-payment" targetRef="audited"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_order-to-cash">
    <bpmndi:BPMNPlane id="BPMNPlane_order-to-cash" bpmnElement="order-to-cash">
      <bpmndi:BPMNShape id="pool-order_di" bpmnElement="pool-order" isHorizontal="true"><dc:Bounds x="160" y="60" width="602" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="220" y="107" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request-payment_di" bpmnElement="request-payment"><dc:Bounds x="336" y="85" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait-for-payment_di" bpmnElement="wait-for-payment"><dc:Bounds x="516" y="85" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="done_di" bpmnElement="done"><dc:Bounds x="696" y="107" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="256" y="125"/><di:waypoint x="336" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="436" y="125"/><di:waypoint x="516" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="616" y="125"/><di:waypoint x="696" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="pool-payment_di" bpmnElement="pool-payment" isHorizontal="true"><dc:Bounds x="160" y="260" width="602" height="260"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane-back-office_di" bpmnElement="lane-back-office" isHorizontal="true"><dc:Bounds x="190" y="260" width="572" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane-treasury_di" bpmnElement="lane-treasury" isHorizontal="true"><dc:Bounds x="190" y="390" width="572" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="payment-start_di" bpmnElement="payment-start"><dc:Bounds x="220" y="437" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="confirm-payment_di" bpmnElement="confirm-payment"><dc:Bounds x="336" y="285" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="report-payment_di" bpmnElement="report-payment"><dc:Bounds x="516" y="415" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="audited_di" bpmnElement="audited"><dc:Bounds x="696" y="437" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="738" y="439" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="g1_di" bpmnElement="g1"><di:waypoint x="256" y="455"/><di:waypoint x="296" y="455"/><di:waypoint x="296" y="325"/><di:waypoint x="336" y="325"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="g2_di" bpmnElement="g2"><di:waypoint x="436" y="325"/><di:waypoint x="476" y="325"/><di:waypoint x="476" y="455"/><di:waypoint x="516" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="g3_di" bpmnElement="g3"><di:waypoint x="616" y="455"/><di:waypoint x="696" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="pool-auditor_di" bpmnElement="pool-auditor" isHorizontal="true"><dc:Bounds x="160" y="590" width="602" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="mf-request_di" bpmnElement="mf-request"><di:waypoint x="386" y="165"/><di:waypoint x="386" y="225"/><di:waypoint x="238" y="225"/><di:waypoint x="238" y="437"/><bpmndi:BPMNLabel><dc:Bounds x="396" y="198" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf-received_di" bpmnElement="mf-received"><di:waypoint x="566" y="415"/><di:waypoint x="566" y="165"/><bpmndi:BPMNLabel><dc:Bounds x="576" y="232" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf-audit_di" bpmnElement="mf-audit"><di:waypoint x="714" y="473"/><di:waypoint x="714" y="590"/><bpmndi:BPMNLabel><dc:Bounds x="724" y="528" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

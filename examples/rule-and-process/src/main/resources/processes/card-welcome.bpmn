<?xml version="1.0" encoding="UTF-8"?>
<!-- Card welcome: a script works out the yearly fee from the monthly fee, a clerk posts the card (a manual task, done
     outside the engine) and a plain task marks the end of the hand-over. Not loaded at start-up; import it with the
     steps in the Process Engine import guide. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:horus="urn:horus-bpm:bpmn:extensions:v1"
                  id="Definitions_card-welcome"
                  targetNamespace="urn:horus-bpm:examples"
                  expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:process id="card-welcome" name="Card welcome" isExecutable="true">
    <bpmn:startEvent id="start" name="Card approved"/>
    <bpmn:scriptTask id="yearly-fee" name="Work out the yearly fee" scriptFormat="urn:horus-bpm:expr:v1" horus:resultVariable="yearlyFee">
      <bpmn:script>monthlyFee * 12</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:manualTask id="post-card" name="Post the card to the customer"/>
    <bpmn:task id="handed-over" name="Card handed over"/>
    <bpmn:endEvent id="end" name="Welcome complete"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="yearly-fee"/>
    <bpmn:sequenceFlow id="f2" sourceRef="yearly-fee" targetRef="post-card"/>
    <bpmn:sequenceFlow id="f3" sourceRef="post-card" targetRef="handed-over"/>
    <bpmn:sequenceFlow id="f4" sourceRef="handed-over" targetRef="end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_card-welcome">
    <bpmndi:BPMNPlane id="BPMNPlane_card-welcome" bpmnElement="card-welcome">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="30" y="67" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="yearly-fee_di" bpmnElement="yearly-fee"><dc:Bounds x="146" y="45" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="post-card_di" bpmnElement="post-card"><dc:Bounds x="326" y="45" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="handed-over_di" bpmnElement="handed-over"><dc:Bounds x="506" y="45" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="686" y="67" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="66" y="85"/><di:waypoint x="146" y="85"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="246" y="85"/><di:waypoint x="326" y="85"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="426" y="85"/><di:waypoint x="506" y="85"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="606" y="85"/><di:waypoint x="686" y="85"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

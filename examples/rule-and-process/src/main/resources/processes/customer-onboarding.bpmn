<?xml version="1.0" encoding="UTF-8"?>
<!-- Customer onboarding: the checks are an ad-hoc sub-process, so the officer starts them in any order; it ends as
     soon as the identity check has passed (completion condition). A refused identity ends the whole process with a
     terminate end event; a passed one calls the card-welcome process through a call activity. Import card-welcome
     first. -->
<bpmn:definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:horus="urn:horus-bpm:bpmn:extensions:v1"
                  id="Definitions_customer-onboarding"
                  targetNamespace="urn:horus-bpm:examples"
                  expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:process id="customer-onboarding" name="Customer onboarding" isExecutable="true">
    <bpmn:startEvent id="start" name="Customer applies"/>
    <bpmn:adHocSubProcess id="checks" name="Onboarding checks" ordering="Parallel">
      <bpmn:userTask id="collect-id" name="Collect and check the identity" horus:assignee="role:CARD_OFFICER" horus:resultVariable="idCheck"/>
      <bpmn:userTask id="screen-sanctions" name="Screen against sanctions lists" horus:assignee="role:BRANCH_SUPERVISOR" horus:resultVariable="sanctions"/>
      <bpmn:completionCondition>idCheck.passed == true</bpmn:completionCondition>
    </bpmn:adHocSubProcess>
    <bpmn:exclusiveGateway id="identity-ok" name="Identity passed?" default="to-refused"/>
    <bpmn:callActivity id="welcome" name="Send the welcome pack" calledElement="card-welcome">
      <bpmn:extensionElements>
        <horus:input name="monthlyFee" value="${instance.monthlyFee}"/>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:endEvent id="onboarded" name="Customer onboarded"/>
    <bpmn:endEvent id="refused" name="Onboarding refused">
      <bpmn:terminateEventDefinition/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="checks"/>
    <bpmn:sequenceFlow id="f2" sourceRef="checks" targetRef="identity-ok"/>
    <bpmn:sequenceFlow id="to-welcome" name="passed" sourceRef="identity-ok" targetRef="welcome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:horus-bpm:expr:v1">idCheck.passed == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="to-refused" name="refused" sourceRef="identity-ok" targetRef="refused"/>
    <bpmn:sequenceFlow id="f5" sourceRef="welcome" targetRef="onboarded"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_customer-onboarding">
    <bpmndi:BPMNPlane id="Plane_customer-onboarding" bpmnElement="customer-onboarding">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="150" y="207" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="checks_di" bpmnElement="checks" isExpanded="true"><dc:Bounds x="246" y="80" width="180" height="290"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="collect-id_di" bpmnElement="collect-id"><dc:Bounds x="286" y="120" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="screen-sanctions_di" bpmnElement="screen-sanctions"><dc:Bounds x="286" y="250" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="identity-ok_di" bpmnElement="identity-ok" isMarkerVisible="true"><dc:Bounds x="486" y="200" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="welcome_di" bpmnElement="welcome"><dc:Bounds x="596" y="185" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="onboarded_di" bpmnElement="onboarded"><dc:Bounds x="756" y="207" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="refused_di" bpmnElement="refused"><dc:Bounds x="628" y="420" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="186" y="225"/><di:waypoint x="246" y="225"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="426" y="225"/><di:waypoint x="486" y="225"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to-welcome_di" bpmnElement="to-welcome"><di:waypoint x="536" y="225"/><di:waypoint x="596" y="225"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to-refused_di" bpmnElement="to-refused"><di:waypoint x="536" y="225"/><di:waypoint x="582" y="225"/><di:waypoint x="582" y="438"/><di:waypoint x="628" y="438"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="696" y="225"/><di:waypoint x="756" y="225"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

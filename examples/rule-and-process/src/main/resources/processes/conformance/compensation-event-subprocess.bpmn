      <bpmndi:BPMNShape id="disburse_di" bpmnElement="disburse" isExpanded="true"><dc:Bounds x="246" y="80" width="868" height="370"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="disburse-start_di" bpmnElement="disburse-start"><dc:Bounds x="534" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reserve-funds_di" bpmnElement="reserve-funds"><dc:Bounds x="878" y="120" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="disburse-end_di" bpmnElement="disburse-end"><dc:Bounds x="1038" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="undo-disbursement_di" bpmnElement="undo-disbursement" isExpanded="true"><dc:Bounds x="286" y="250" width="532" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="undo-start_di" bpmnElement="undo-start"><dc:Bounds x="326" y="312" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reverse-disbursement_di" bpmnElement="reverse-disbursement"><dc:Bounds x="422" y="290" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify-treasury_di" bpmnElement="notify-treasury"><dc:Bounds x="582" y="290" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="undo-end_di" bpmnElement="undo-end"><dc:Bounds x="742" y="312" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="1174" y="247" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="u1_di" bpmnElement="u1"><di:waypoint x="362" y="330"/><di:waypoint x="422" y="330"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="u2_di" bpmnElement="u2"><di:waypoint x="522" y="330"/><di:waypoint x="582" y="330"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="u3_di" bpmnElement="u3"><di:waypoint x="682" y="330"/><di:waypoint x="742" y="330"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="d1_di" bpmnElement="d1"><di:waypoint x="570" y="160"/><di:waypoint x="878" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="d2_di" bpmnElement="d2"><di:waypoint x="978" y="160"/><di:waypoint x="1038" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="186" y="265"/><di:waypoint x="246" y="265"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="1114" y="265"/><di:waypoint x="1174" y="265"/></bpmndi:BPMNEdge>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:horus="urn:horus-bpm:bpmn:extensions:v1" id="d" targetNamespace="urn:conformance" expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:process id="loan-payout-manual-undo" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:serviceTask id="disburse" horus:handler="post-debit"/>
    <bpmn:boundaryEvent id="disburse-undo" attachedToRef="disburse" cancelActivity="false">
      <bpmn:compensateEventDefinition/>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="reverse-by-operator" isForCompensation="true"/>
    <bpmn:association id="disburse-undo-link" associationDirection="One" sourceRef="disburse-undo" targetRef="reverse-by-operator"/>
    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="disburse"/>
    <bpmn:sequenceFlow id="f2" sourceRef="disburse" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Large payment released after any two of three sign-offs: a complex gateway joins the three branches and fires
     once its activation condition holds (_activationCount >= 2); the third sign-off, when it comes, is absorbed.
     Each sign-off is a four-eyes task, so the person who started the payment cannot sign it. -->
<bpmn:definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:horus="urn:horus-bpm:bpmn:extensions:v1"
                  id="Definitions_payment-approval"
                  targetNamespace="urn:horus-bpm:examples"
                  expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:process id="payment-approval" name="Large payment approval" isExecutable="true">
    <bpmn:startEvent id="start" name="Payment submitted"/>
    <bpmn:parallelGateway id="fork" name="Ask three approvers"/>
    <bpmn:userTask id="card-ops-signoff" name="Card operations sign-off" horus:assignee="role:CARD_OFFICER" horus:fourEyes="true" horus:resultVariable="cardOps"/>
    <bpmn:userTask id="supervisor-signoff" name="Branch supervisor sign-off" horus:assignee="role:BRANCH_SUPERVISOR" horus:fourEyes="true" horus:resultVariable="supervisor"/>
    <bpmn:userTask id="operations-signoff" name="Operations sign-off" horus:assignee="role:OPERATIONS_OFFICER" horus:fourEyes="true" horus:resultVariable="operations"/>
    <bpmn:complexGateway id="two-of-three" name="Two of three signed">
      <bpmn:activationCondition>_activationCount &gt;= 2</bpmn:activationCondition>
    </bpmn:complexGateway>
    <bpmn:serviceTask id="release-payment" name="Release the payment" horus:handler="payments.release" horus:resultVariable="released"/>
    <bpmn:endEvent id="end" name="Payment released"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="fork"/>
    <bpmn:sequenceFlow id="f2" sourceRef="fork" targetRef="card-ops-signoff"/>
    <bpmn:sequenceFlow id="f3" sourceRef="fork" targetRef="supervisor-signoff"/>
    <bpmn:sequenceFlow id="f4" sourceRef="fork" targetRef="operations-signoff"/>
    <bpmn:sequenceFlow id="f5" sourceRef="card-ops-signoff" targetRef="two-of-three"/>
    <bpmn:sequenceFlow id="f6" sourceRef="supervisor-signoff" targetRef="two-of-three"/>
    <bpmn:sequenceFlow id="f7" sourceRef="operations-signoff" targetRef="two-of-three"/>
    <bpmn:sequenceFlow id="f8" sourceRef="two-of-three" targetRef="release-payment"/>
    <bpmn:sequenceFlow id="f9" sourceRef="release-payment" targetRef="end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_payment-approval">
    <bpmndi:BPMNPlane id="Plane_payment-approval" bpmnElement="payment-approval">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="150" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork_di" bpmnElement="fork"><dc:Bounds x="246" y="95" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="card-ops-signoff_di" bpmnElement="card-ops-signoff"><dc:Bounds x="356" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="supervisor-signoff_di" bpmnElement="supervisor-signoff"><dc:Bounds x="356" y="210" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="operations-signoff_di" bpmnElement="operations-signoff"><dc:Bounds x="356" y="340" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="two-of-three_di" bpmnElement="two-of-three"><dc:Bounds x="516" y="95" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="release-payment_di" bpmnElement="release-payment"><dc:Bounds x="626" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="786" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="186" y="120"/><di:waypoint x="246" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="296" y="120"/><di:waypoint x="356" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="296" y="120"/><di:waypoint x="326" y="120"/><di:waypoint x="326" y="250"/><di:waypoint x="356" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="296" y="120"/><di:waypoint x="326" y="120"/><di:waypoint x="326" y="380"/><di:waypoint x="356" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="456" y="120"/><di:waypoint x="516" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="456" y="250"/><di:waypoint x="486" y="250"/><di:waypoint x="486" y="120"/><di:waypoint x="516" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="456" y="380"/><di:waypoint x="486" y="380"/><di:waypoint x="486" y="120"/><di:waypoint x="516" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="566" y="120"/><di:waypoint x="626" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="726" y="120"/><di:waypoint x="786" y="120"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

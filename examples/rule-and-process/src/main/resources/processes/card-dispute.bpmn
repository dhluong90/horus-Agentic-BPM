<?xml version="1.0" encoding="UTF-8"?>
<!-- Card dispute: an officer assesses a dispute and, if it is not done in two days, a reminder goes to the officer
     while the task stays open (a timer boundary that does not interrupt). The refund step answers the business error
     REFUND_LIMIT_EXCEEDED when the amount is above the officer's limit; an error boundary takes that code to a senior
     approval instead of opening an incident. Start it with amountMinor (the refund in minor units): above 5,000,000
     the refund step raises the error, at or below it the refund posts. Both paths end at one customer notification
     through a link, so the notification is modelled once. The dev profile loads it at start-up; elsewhere, import it
     with the steps in the Process Engine import guide. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:horus="urn:horus-bpm:bpmn:extensions:v1"
                  id="Definitions_card-dispute"
                  targetNamespace="urn:horus-bpm:examples"
                  expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:error id="Err_limit" name="Refund limit exceeded" errorCode="REFUND_LIMIT_EXCEEDED"/>
  <bpmn:process id="card-dispute" name="Card dispute" isExecutable="true">
    <bpmn:startEvent id="start" name="Dispute received"/>
    <bpmn:userTask id="assess" name="Assess the dispute" horus:assignee="role:DISPUTES_OFFICER" horus:resultVariable="assessment"/>
    <bpmn:boundaryEvent id="assess-overdue" name="Two days passed" attachedToRef="assess" cancelActivity="false">
      <bpmn:timerEventDefinition><bpmn:timeDuration>P2D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="remind-officer" name="Remind the officer" horus:handler="disputes.remind"/>
    <bpmn:endEvent id="reminded" name="Reminder sent"/>
    <bpmn:serviceTask id="post-refund" name="Post the refund" horus:handler="disputes.refund">
      <bpmn:extensionElements>
        <horus:input name="amountMinor" value="${instance.amountMinor}"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="over-limit" name="Above the officer's limit" attachedToRef="post-refund">
      <bpmn:errorEventDefinition errorRef="Err_limit"/>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="senior-approval" name="Senior approval" horus:assignee="role:DISPUTES_SENIOR" horus:resultVariable="approval"/>
    <bpmn:intermediateThrowEvent id="refund-done" name="Refund settled">
      <bpmn:linkEventDefinition name="notify"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="approval-done" name="Approval settled">
      <bpmn:linkEventDefinition name="notify"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="notify-entry" name="Notify the customer">
      <bpmn:linkEventDefinition name="notify"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="notify-customer" name="Notify the customer" horus:handler="disputes.notify"/>
    <bpmn:endEvent id="closed" name="Dispute closed"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="assess"/>
    <bpmn:sequenceFlow id="f2" sourceRef="assess" targetRef="post-refund"/>
    <bpmn:sequenceFlow id="f3" sourceRef="assess-overdue" targetRef="remind-officer"/>
    <bpmn:sequenceFlow id="f4" sourceRef="remind-officer" targetRef="reminded"/>
    <bpmn:sequenceFlow id="f5" sourceRef="post-refund" targetRef="refund-done"/>
    <bpmn:sequenceFlow id="f6" sourceRef="over-limit" targetRef="senior-approval"/>
    <bpmn:sequenceFlow id="f7" sourceRef="senior-approval" targetRef="approval-done"/>
    <bpmn:sequenceFlow id="f8" sourceRef="notify-entry" targetRef="notify-customer"/>
    <bpmn:sequenceFlow id="f9" sourceRef="notify-customer" targetRef="closed"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_card-dispute">
    <bpmndi:BPMNPlane id="BPMNPlane_card-dispute" bpmnElement="card-dispute">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="30" y="82" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="assess_di" bpmnElement="assess"><dc:Bounds x="146" y="60" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="remind-officer_di" bpmnElement="remind-officer"><dc:Bounds x="326" y="335" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reminded_di" bpmnElement="reminded"><dc:Bounds x="538" y="357" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="post-refund_di" bpmnElement="post-refund"><dc:Bounds x="326" y="60" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="senior-approval_di" bpmnElement="senior-approval"><dc:Bounds x="506" y="205" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="refund-done_di" bpmnElement="refund-done"><dc:Bounds x="538" y="82" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approval-done_di" bpmnElement="approval-done"><dc:Bounds x="686" y="227" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify-entry_di" bpmnElement="notify-entry"><dc:Bounds x="30" y="487" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify-customer_di" bpmnElement="notify-customer"><dc:Bounds x="146" y="465" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="closed_di" bpmnElement="closed"><dc:Bounds x="358" y="487" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="assess-overdue_di" bpmnElement="assess-overdue"><dc:Bounds x="178" y="122" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="200" y="162" width="74" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="over-limit_di" bpmnElement="over-limit"><dc:Bounds x="358" y="122" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="380" y="162" width="74" height="44"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="66" y="100"/><di:waypoint x="146" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="246" y="100"/><di:waypoint x="326" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="196" y="158"/><di:waypoint x="196" y="375"/><di:waypoint x="326" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="426" y="375"/><di:waypoint x="538" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="426" y="100"/><di:waypoint x="538" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="376" y="158"/><di:waypoint x="376" y="245"/><di:waypoint x="506" y="245"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="606" y="245"/><di:waypoint x="686" y="245"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="66" y="505"/><di:waypoint x="146" y="505"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="246" y="505"/><di:waypoint x="358" y="505"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Worked example: an order asks its payer to pay (send task), waits for the payment (receive task, correlated by
     the order number) and tells the warehouse (message end event). A host consumer delivers payment-received with
     POST /messages:correlate; the engine never listens. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:horus="urn:horus-bpm:bpmn:extensions:v1"
                  id="Definitions_order-payment" targetNamespace="urn:horus-bpm:examples"
                  expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:message id="m-requested" name="payment-requested"/>
  <bpmn:message id="m-received" name="payment-received"/>
  <bpmn:message id="m-ready" name="order-ready-to-ship"/>
  <bpmn:process id="order-payment" name="Order payment" isExecutable="true">
    <bpmn:startEvent id="start" name="Order placed"/>
    <bpmn:sendTask id="request-payment" name="Ask the payer to pay" messageRef="m-requested" horus:correlationKey="orderId">
      <bpmn:extensionElements>
        <horus:input name="amount" value="${instance.amount}"/>
      </bpmn:extensionElements>
    </bpmn:sendTask>
    <bpmn:receiveTask id="wait-for-payment" name="Wait for the payment" messageRef="m-received" horus:correlationKey="orderId">
      <bpmn:extensionElements>
        <horus:output name="paymentRef" from="reference"/>
      </bpmn:extensionElements>
    </bpmn:receiveTask>
    <bpmn:endEvent id="ready" name="Ready to ship" horus:correlationKey="orderId">
      <bpmn:extensionElements>
        <horus:input name="paymentRef" value="${instance.paymentRef}"/>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition messageRef="m-ready"/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="request-payment"/>
    <bpmn:sequenceFlow id="f2" sourceRef="request-payment" targetRef="wait-for-payment"/>
    <bpmn:sequenceFlow id="f3" sourceRef="wait-for-payment" targetRef="ready"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_order-payment">
    <bpmndi:BPMNPlane id="BPMNPlane_order-payment" bpmnElement="order-payment">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="30" y="67" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request-payment_di" bpmnElement="request-payment"><dc:Bounds x="146" y="45" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait-for-payment_di" bpmnElement="wait-for-payment"><dc:Bounds x="326" y="45" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ready_di" bpmnElement="ready"><dc:Bounds x="506" y="67" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="66" y="85"/><di:waypoint x="146" y="85"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="246" y="85"/><di:waypoint x="326" y="85"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="426" y="85"/><di:waypoint x="506" y="85"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

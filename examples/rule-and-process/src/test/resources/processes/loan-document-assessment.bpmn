<?xml version="1.0" encoding="UTF-8"?>
<!-- A guarded agent step (#52). An agent reads a loan application's documents and answers with a risk score and a
     recommendation. The answer must meet the output schema, and the bank's guardrail rule set
     agent-output-guardrails refuses a risk score of 70 or more: such an answer opens a four-eyes review task for a
     compliance reviewer instead of moving the loan on. The agent never decides alone. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:horus="urn:horus-bpm:bpmn:extensions:v1"
                  id="Definitions_loan-document-assessment"
                  targetNamespace="urn:horus-bpm:examples"
                  expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:process id="loan-document-assessment" name="Loan document assessment" isExecutable="true">
    <bpmn:startEvent id="start" name="Documents received"/>
    <bpmn:serviceTask id="assess-documents" name="Assess the documents" horus:type="agentTask"
                      horus:agent="documents.assess" horus:timeout="PT30S" horus:resultVariable="assessment">
      <bpmn:extensionElements>
        <horus:input name="applicationId" value="${instance.applicationId}"/>
        <horus:input name="requestedAmount" value="${instance.amount}"/>
        <horus:outputSchema>{
          "type": "object",
          "required": ["riskScore", "recommendation"],
          "additionalProperties": false,
          "properties": {
            "riskScore": {"type": "integer", "minimum": 0, "maximum": 100},
            "recommendation": {"type": "string", "enum": ["APPROVE", "REFER", "DECLINE"]},
            "summary": {"type": "string", "maxLength": 500, "mask": true}
          }
        }</horus:outputSchema>
        <horus:guardrail decision="agent-output-guardrails" onViolation="route-to-human"
                         reviewer="role:COMPLIANCE_REVIEWER"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="underwrite" name="Underwrite the loan" horus:assignee="role:CARD_OFFICER" horus:resultVariable="decision"/>
    <bpmn:endEvent id="end" name="Decided"/>
    <bpmn:sequenceFlow id="start__assess" sourceRef="start" targetRef="assess-documents"/>
    <bpmn:sequenceFlow id="assess__underwrite" sourceRef="assess-documents" targetRef="underwrite"/>
    <bpmn:sequenceFlow id="underwrite__end" sourceRef="underwrite" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>

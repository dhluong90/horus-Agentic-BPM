<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Bill of materials for hosts. It has no parent on purpose: an imported BOM carries its parent's
    dependency management, and this one must pin engine modules only, never the host's Spring Boot,
    Flyway or driver versions.
  -->
  <groupId>io.github.dhluong90.bpm</groupId>
  <artifactId>bpm-bom</artifactId>
  <version>0.3.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>HORUS Agentic BPM BOM</name>
  <description>Pins the version of every HORUS Agentic BPM module.</description>
  <url>https://github.com/dhluong90/horus-Agentic-BPM</url>

  <!-- TR-LIC-02: same notice as the parent POM, repeated because this BOM has no parent. -->
  <licenses>
    <license>
      <name>PolyForm-Noncommercial-1.0.0</name>
      <url>https://polyformproject.org/licenses/noncommercial/1.0.0</url>
      <distribution>repo</distribution>
    </license>
    <license>
      <name>LicenseRef-HORUS-Commercial</name>
      <url>https://github.com/dhluong90/horus-Agentic-BPM/blob/main/COMMERCIAL-LICENSE.md</url>
      <distribution>manual</distribution>
      <comments>Any use not permitted by the PolyForm Noncommercial License needs a separate written agreement with HORUS.</comments>
    </license>
  </licenses>

  <organization>
    <name>HORUS</name>
    <url>https://github.com/dhluong90/horus-Agentic-BPM</url>
  </organization>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>bpm-host-metadata</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>bpm-expression</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>rule-engine-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>rule-engine-postgres</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>rule-engine-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>rule-engine-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>process-engine-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>process-engine-bpmn</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>process-engine-test</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>process-engine-postgres</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>process-engine-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>process-engine-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dhluong90.bpm</groupId>
        <artifactId>cockpit-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Bill of materials for hosts. It has no parent on purpose: an imported BOM carries its parent's
    dependency management, and this one must pin engine modules only, never the host's Spring Boot,
    Flyway or driver versions.
  -->
  <groupId>com.horus.bpm</groupId>
  <artifactId>bpm-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>HORUS Agentic BPM BOM</name>
  <description>Pins the version of every HORUS Agentic BPM module.</description>
  <url>https://github.com/dhluong90/horus-Agentic-BPM</url>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.horus.bpm</groupId>
        <artifactId>rule-engine-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.horus.bpm</groupId>
        <artifactId>rule-engine-postgres</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.horus.bpm</groupId>
        <artifactId>rule-engine-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.horus.bpm</groupId>
        <artifactId>rule-engine-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>

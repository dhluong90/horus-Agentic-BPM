<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.horus.bpm</groupId>
    <artifactId>rule-engine-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rule-engine-postgres</artifactId>
  <name>HORUS Rule Engine PostgreSQL</name>
  <description>PostgreSQL storage of the Rule Engine: rle_* migrations and storage adapters on the host DataSource.</description>

  <dependencies>
    <dependency>
      <groupId>com.horus.bpm</groupId>
      <artifactId>rule-engine-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <!--
        TR-EMB-05 and TR-AGT-03 by dependency analysis: ArchUnit sees only referenced bytecode, so this
        rule also refuses an HTTP or model client artifact that no class references yet.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-no-network-client</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <!-- TR-AGT-03, TR-EMB-05: no HTTP or model client library, even one no class references yet. -->
                    <exclude>com.squareup.okhttp3:*</exclude>
                    <exclude>com.squareup.retrofit2:*</exclude>
                    <exclude>org.apache.httpcomponents*:*</exclude>
                    <exclude>org.asynchttpclient:*</exclude>
                    <exclude>io.github.openfeign:*</exclude>
                    <exclude>io.netty:*</exclude>
                    <exclude>io.projectreactor.netty:*</exclude>
                    <exclude>org.eclipse.jetty:jetty-client</exclude>
                    <exclude>org.springframework:spring-web</exclude>
                    <exclude>org.springframework:spring-webflux</exclude>
                    <exclude>org.springframework.ai:*</exclude>
                    <exclude>dev.langchain4j:*</exclude>
                    <exclude>com.openai:*</exclude>
                    <exclude>com.anthropic:*</exclude>
                    <exclude>com.azure:azure-ai-*</exclude>
                    <exclude>com.google.cloud:google-cloud-vertexai</exclude>
                    <exclude>com.google.genai:*</exclude>
                    <exclude>software.amazon.awssdk:*</exclude>
                  </excludes>
                  <message>rule-engine-postgres never calls the network: no HTTP or model client artifact (TR-EMB-05, TR-AGT-03).</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

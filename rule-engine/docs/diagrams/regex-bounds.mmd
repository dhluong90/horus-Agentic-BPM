flowchart TD
  A["Import: cell matches('^FT[0-9]{8}$')"] --> B{"Pattern is a string literal, at most 1,000 characters, no back-reference, no look-around?"}
  B -- no --> C["422 VALIDATION_FAILED naming the rule and column; nothing stored"]
  B -- yes --> D["Compiled once with the version"]
  D --> E["Evaluate: text of the input"]
  E --> F{"Text null?"}
  F -- yes --> G["null, the condition does not match"]
  F -- no --> H{"Longer than evaluation.regex-max-input-length?"}
  H -- yes --> I["EVALUATION_ERROR, error_code REGEX_INPUT_TOO_LONG; the match never runs"]
  H -- no --> J["Matcher reads the text through a deadline CharSequence"]
  J --> K{"Finished before evaluation.regex-timeout-ms?"}
  K -- yes --> L["true or false; evaluation continues"]
  K -- no --> M["EVALUATION_ERROR, error_code REGEX_TIMEOUT; the thread returns at once"]
  I --> N["One decision row in the host transaction, 422 over REST"]
  M --> N

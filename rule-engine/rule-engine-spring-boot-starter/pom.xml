<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.dhluong90.bpm</groupId>
    <artifactId>rule-engine-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
  </parent>

  <artifactId>rule-engine-spring-boot-starter</artifactId>
  <name>HORUS Rule Engine Spring Boot Starter</name>
  <description>Auto-configures the Rule Engine on the host's DataSource and transaction manager.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>rule-engine-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>rule-engine-postgres</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The host contract: the starter contributes the rules entry of /api/bpm/meta and /api/bpm/me. -->
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>bpm-host-metadata</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>rule-engine-rest</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- Optional: the REST controllers are registered only in a servlet web host. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Optional: with Spring Security the caller and its rules:* permissions come from the security context. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Optional: token claims (tenant_id) of an OAuth2 principal, read only when the host has OAuth2. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-core</artifactId>
      <optional>true</optional>
    </dependency>
    <!--
      Spring Framework artifact present on both Spring Boot lines. No Boot 4-only module is a required
      dependency: auto-configuration ordering uses class names as strings (ADR-0011).
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <!--
      Optional: the horus.rle.* gauges (DESIGN section 4.8) are bound to the host's meter registry through a
      MeterBinder only when the host has Micrometer, for example through Actuator. Version from the Spring Boot BOM.
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <optional>true</optional>
    </dependency>
    <!--
      The ruleEngine health contributor, one per Spring Boot line (RuleEngineHealthCheck plus an adapter).
      Spring Boot 4: the optional spring-boot-health module. The 3.5 test leg excludes it from the test
      classpath (root POM, profile spring-boot-3.5).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
      <optional>true</optional>
    </dependency>
    <!--
      Spring Boot 3.5: the Actuator health API, compile only. Provided scope is never passed to hosts, so
      a Spring Boot 4 host gets no 3.5 artifact; a 3.5 host with Actuator has this jar already. Only the
      jar itself is used, none of its Spring Boot 3.5 dependencies.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
      <version>${spring-boot-3.5.version}</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
      <!-- Only the engine version file is filtered: it carries ${project.version} into /api/bpm/meta. -->
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
      <!-- Repeated from the parent, which this list replaces (TR-LIC-02). -->
      <resource>
        <directory>${bpm.root}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>COMMERCIAL-LICENSE.md</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- #373: the retention requirement switches on at 1.0, read from this jar's Implementation-Version -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <rule-engine.version>${project.version}</rule-engine.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${spring-boot.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

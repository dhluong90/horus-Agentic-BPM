<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.dhluong90.bpm</groupId>
    <artifactId>rule-engine-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>rule-engine-core</artifactId>
  <name>HORUS Rule Engine Core</name>
  <description>Framework-free model, compiler and evaluator of the Rule Engine. Depends on the JDK and, inside its internal packages only, Jackson 3.</description>

  <!--
    Jackson 3 (tools.jackson) is the only compile dependency, used in ..internal.. only (ADR-0021).
    Versions come from the Spring Boot BOM imported by the parent.
  -->
  <dependencies>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- RLE-021: the reference FEEL implementation, test scope only; it never ships (ArchUnit, enforcer). -->
    <dependency>
      <groupId>org.camunda.feel</groupId>
      <artifactId>feel-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        TR-EMB-03 by dependency analysis: ArchUnit sees only referenced bytecode, so this rule also
        refuses framework, Jakarta, pool and JDBC driver artifacts that no class references yet.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!-- TR-EMB-05, TR-AGT-03: the shared list in the root POM's pluginManagement. -->
          <execution>
            <id>enforce-no-network-client</id>
            <phase>validate</phase>
          </execution>
          <execution>
            <id>enforce-framework-free-core</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.springframework*:*</exclude>
                    <exclude>jakarta.*:*</exclude>
                    <exclude>javax.*:*</exclude>
                    <exclude>com.zaxxer:*</exclude>
                    <exclude>org.postgresql:*</exclude>
                    <exclude>com.mysql:*</exclude>
                    <exclude>org.mariadb.jdbc:*</exclude>
                    <exclude>com.oracle.database.jdbc:*</exclude>
                    <exclude>com.microsoft.sqlserver:*</exclude>
                    <exclude>com.h2database:*</exclude>
                    <exclude>org.hsqldb:*</exclude>
                    <!--
                      TR-EMB-07, ADR-0021: one JSON major in the core, Jackson 3; never Jackson 2 or another JSON library.
                      Jackson 2 is banned in every scope that ships or that a host supplies. Test scope only, it comes
                      with the reference FEEL implementation of RLE-021, whose built-in functions load it.
                    -->
                    <exclude>com.fasterxml.jackson.core:jackson-databind:*:*:compile</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-databind:*:*:runtime</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-databind:*:*:provided</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-core:*:*:compile</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-core:*:*:runtime</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-core:*:*:provided</exclude>
                    <exclude>com.fasterxml.jackson.dataformat:*</exclude>
                    <exclude>com.fasterxml.jackson.module:*:*:*:compile</exclude>
                    <exclude>com.fasterxml.jackson.module:*:*:*:runtime</exclude>
                    <exclude>com.fasterxml.jackson.module:*:*:*:provided</exclude>
                    <exclude>com.google.code.gson:*</exclude>
                    <exclude>org.json:*</exclude>
                    <exclude>jakarta.json*:*</exclude>
                    <exclude>javax.json*:*</exclude>
                    <exclude>com.alibaba*:fastjson*</exclude>
                  </excludes>
                  <message>rule-engine-core depends on the JDK and Jackson 3 only: no framework, Jakarta, pool, JDBC driver or second JSON library (TR-EMB-03, ADR-0021).</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

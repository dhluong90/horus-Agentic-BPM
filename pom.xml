<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Build parent for every engine module and example host.
    The groupId is set here once; the value is still open (rule-engine/docs/DESIGN.md, open question 7.2).
    Hosts never inherit from this POM: they import bpm-bom, which pins engine modules only.
  -->
  <groupId>io.github.dhluong90.bpm</groupId>
  <artifactId>bpm-parent</artifactId>
  <version>0.2.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>HORUS Agentic BPM</name>
  <description>Embeddable Process Engine and Rule Engine for Java and Spring Boot.</description>
  <url>https://github.com/dhluong90/horus-Agentic-BPM</url>

  <!--
    TR-LIC-02: every artifact carries the project licence notice and the commercial-licence pointer.
    Inherited by every module; bpm-bom has no parent and repeats this block.
  -->
  <licenses>
    <license>
      <name>PolyForm-Noncommercial-1.0.0</name>
      <url>https://polyformproject.org/licenses/noncommercial/1.0.0</url>
      <distribution>repo</distribution>
    </license>
    <license>
      <name>LicenseRef-HORUS-Commercial</name>
      <url>https://github.com/dhluong90/horus-Agentic-BPM/blob/main/COMMERCIAL-LICENSE.md</url>
      <distribution>manual</distribution>
      <comments>Any use not permitted by the PolyForm Noncommercial License needs a separate written agreement with HORUS.</comments>
    </license>
  </licenses>

  <organization>
    <name>HORUS</name>
    <url>https://github.com/dhluong90/horus-Agentic-BPM</url>
  </organization>

  <modules>
    <module>bpm-bom</module>
    <module>bpm-host-metadata</module>
    <module>rule-engine</module>
    <module>process-engine</module>
    <module>cockpit</module>
    <module>examples</module>
  </modules>

  <properties>
    <java.release>21</java.release>
    <maven.compiler.release>${java.release}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- ADR-0011: build against the newest generally available Spring Boot 4.x minor. -->
    <spring-boot-4.version>4.1.2</spring-boot-4.version>
    <spring-boot.version>${spring-boot-4.version}</spring-boot.version>
    <!--
      TR-EMB-02: the other lines tested on the jars built with spring-boot-4.version. -Dspring-boot.line
      switches the runtime classpath of the tests (profiles below, and the CI matrix):
        absent or 4.x  newest 4.x minor (the build line)
        4.0            Spring Boot 4.0.x, latest patch, while 4.0 is in open-source support (ADR-0011)
        3.5            Spring Boot 3.5.x, minimum tested patch, until 1.0
      Any other value fails the build (enforce-build-baseline).
    -->
    <spring-boot.line>4.x</spring-boot.line>
    <spring-boot-4.0.version>4.0.9</spring-boot-4.0.version>
    <spring-boot-3.5.version>3.5.16</spring-boot-3.5.version>
    <!-- Test-only libraries kept on the line the tests are compiled with, on both Spring Boot lines. -->
    <testcontainers-2.version>2.0.5</testcontainers-2.version>
    <!--
      Jackson 3 inside the engine cores (ADR-0021). Spring Boot 3.5 does not manage it, so the 3.5
      profile pins this version. It must equal the Jackson 3 version that spring-boot-4.version
      manages; tools/check-jackson-coexistence.py fails the 3.5 legs when they differ.
    -->
    <jackson-3.version>3.1.7</jackson-3.version>
    <!--
      Container images the tests start, pinned by digest (PD-100); tests read them through TestImages and
      name no image themselves. Testcontainers 2 refuses a tag and a digest together, so the value is
      <name>@sha256:<digest> and the comment names the tag and the version the digest resolved to. Update
      digest and comment together (wiki Contributing, Dependency checks, test container images). The CI matrix
      sets the PostgreSQL image per leg (14, 16 and 18), also pinned; tools/check-image-pins.py refuses
      an image reference without a digest.
    -->
    <!-- postgres:16-alpine, PostgreSQL 16.16, resolved 20 Nov 2026 (the image docker-compose.yml pins). -->
    <bpm.test.postgres.image>postgres@sha256:1d5b02d3a9941fbd52437db4107f8c52d6297dac553ca1e5c299ebb3756b4857</bpm.test.postgres.image>
    <!-- edoburu/pgbouncer:v1.26.1-p0, resolved 20 Nov 2026. -->
    <bpm.test.pgbouncer.image>edoburu/pgbouncer@sha256:488422e38cff912895d0d65d8963fcd306e6ac589a724398b6eb8e294e94d624</bpm.test.pgbouncer.image>
    <!-- JUnit tags of tests that apply to one Spring Boot line only; the 3.5 profile swaps the value. -->
    <excludedGroups>spring-boot-3.5-only</excludedGroups>
    <archunit.version>1.5.1</archunit.version>
    <!-- Test scope only: validates REST responses against the published JSON Schemas (Apache 2.0). -->
    <json-schema-validator.version>2.0.1</json-schema-validator.version>
    <!--
      Test scope only: the reference FEEL implementation of the RLE-021 differential test (Apache 2.0).
      Never a dependency of a shipped module (ArchUnit and the enforce-framework-free-core ban).
    -->
    <feel-engine.version>1.22.1</feel-engine.version>

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <license-maven-plugin.version>2.9.0</license-maven-plugin.version>
    <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
    <!-- Run from the command line, not bound to a phase (deploy/docker/Dockerfile, CI, release scripts). -->
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <maven-help-plugin.version>3.6.0</maven-help-plugin.version>
    <!-- Bound by Maven to pom-packaged modules; pinned at the version Maven 3.9 already uses. -->
    <maven-site-plugin.version>3.12.1</maven-site-plugin.version>

    <!-- Root of the reactor, for files every jar carries (LICENSE, COMMERCIAL-LICENSE.md). -->
    <bpm.root>${maven.multiModuleProjectDirectory}</bpm.root>
    <!-- TR-LIC-01 policy: the allowed licences and the spellings merged into them. -->
    <bpm.licence-policy>file://${bpm.root}/tools/licence-policy</bpm.licence-policy>
    <!--
      The one switch for "this module never ships": set to true only in examples/pom.xml, the
      parent of the example hosts (checked by tools/check-dependency-policy.py). It turns off the
      deploy, the licence gate and the shipped SBOM entry together, so no module can skip the
      licence gate and still be published.
    -->
    <maven.deploy.skip>false</maven.deploy.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Modules in this reactor refer to each other with ${project.version}; bpm-bom is for hosts. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.camunda.feel</groupId>
        <artifactId>feel-engine</artifactId>
        <version>${feel-engine.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${java.release}</release>
            <parameters>true</parameters>
            <compilerArgs>
              <arg>-Xlint:all,-processing,-serial</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <systemPropertyVariables>
              <bpm.test.postgres.image>${bpm.test.postgres.image}</bpm.test.postgres.image>
              <bpm.test.pgbouncer.image>${bpm.test.pgbouncer.image}</bpm.test.pgbouncer.image>
              <bpm.root>${bpm.root}</bpm.root>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <!-- Test against target/classes, not a repackaged Spring Boot jar. -->
            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
            <systemPropertyVariables>
              <bpm.test.postgres.image>${bpm.test.postgres.image}</bpm.test.postgres.image>
              <bpm.test.pgbouncer.image>${bpm.test.pgbouncer.image}</bpm.test.pgbouncer.image>
              <bpm.root>${bpm.root}</bpm.root>
            </systemPropertyVariables>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
          <configuration>
            <archive>
              <!-- TR-LIC-02: licence notice and commercial-licence pointer in every jar manifest. -->
              <manifestEntries>
                <Bundle-License>PolyForm-Noncommercial-1.0.0 OR LicenseRef-HORUS-Commercial</Bundle-License>
                <X-HORUS-License>PolyForm Noncommercial License 1.0.0; see META-INF/LICENSE</X-HORUS-License>
                <X-HORUS-Commercial-License>Commercial use needs a separate agreement; see META-INF/COMMERCIAL-LICENSE.md</X-HORUS-Commercial-License>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>${license-maven-plugin.version}</version>
        </plugin>
        <!--
          TR-EMB-05 and TR-AGT-03 by dependency analysis, one list for every *-core and *-postgres module.
          The execution is unbound here; those modules bind it with
            <execution><id>enforce-no-network-client</id><phase>validate</phase></execution>
          ArchUnit's package list for the same rule is tools/architecture/http-and-model-clients.txt.
          Test scope is checked too, on purpose: a test-only HTTP stub needs a decision first.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
          <executions>
            <execution>
              <id>enforce-no-network-client</id>
              <phase>none</phase>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <bannedDependencies>
                    <searchTransitive>true</searchTransitive>
                    <excludes>
                      <exclude>com.squareup.okhttp3:*</exclude>
                      <exclude>com.squareup.retrofit2:*</exclude>
                      <exclude>org.apache.httpcomponents*:*</exclude>
                      <exclude>org.asynchttpclient:*</exclude>
                      <exclude>io.github.openfeign:*</exclude>
                      <exclude>io.netty:*</exclude>
                      <exclude>io.projectreactor.netty:*</exclude>
                      <exclude>org.eclipse.jetty:jetty-client</exclude>
                      <exclude>org.springframework:spring-web</exclude>
                      <exclude>org.springframework:spring-webflux</exclude>
                      <exclude>org.springframework.ai:*</exclude>
                      <exclude>dev.langchain4j:*</exclude>
                      <exclude>com.openai:*</exclude>
                      <exclude>com.anthropic:*</exclude>
                      <exclude>com.azure:azure-ai-*</exclude>
                      <exclude>com.google.cloud:google-cloud-vertexai</exclude>
                      <exclude>com.google.genai:*</exclude>
                      <exclude>software.amazon.awssdk:*</exclude>
                    </excludes>
                    <message>Engine core and storage modules never call the network: no HTTP or model client artifact (TR-EMB-05, TR-AGT-03).</message>
                  </bannedDependencies>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>${cyclonedx-maven-plugin.version}</version>
        </plugin>
        <!--
          Pinned so that a goal called by prefix (mvn help:evaluate, mvn dependency:get, as the image build
          does) resolves the same plugin code every time; requirePluginVersions below checks both.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-help-plugin</artifactId>
          <version>${maven-help-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- TR-LIC-02: LICENSE and COMMERCIAL-LICENSE.md go into META-INF/ of every jar. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${bpm.root}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>COMMERCIAL-LICENSE.md</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <!--
        TR-LIC-01: third-party dependencies that ship or that hosts must supply (compile, runtime
        and provided scope) must be under a licence in tools/licence-policy/allowed-licences.txt.
        The build fails naming the library and its licence. Test scope is out of this check until
        PD-053 decides the rule for test and build tools; system scope is banned by the enforcer.
        tools/licence-policy/licence-merges.txt folds the spellings found in POMs into one SPDX id.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>licence-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
            <configuration>
              <skipAddThirdParty>${maven.deploy.skip}</skipAddThirdParty>
              <excludedScopes>test,system</excludedScopes>
              <excludedGroups>io\.github\.dhluong90\.bpm</excludedGroups>
              <failOnMissing>true</failOnMissing>
              <failOnBlacklist>true</failOnBlacklist>
              <includedLicenses>${bpm.licence-policy}/allowed-licences.txt</includedLicenses>
              <licenseMergesUrl>${bpm.licence-policy}/licence-merges.txt</licenseMergesUrl>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        TR-SEC-06: two CycloneDX SBOMs in the reactor root, both scanned by tools/scan-dependencies.sh.
        target/bom.json (and bom.xml): what ships, the compile, runtime and provided scopes of the
        deployed modules (skipNotDeployed leaves out modules with maven.deploy.skip). High or
        critical findings fail the build.
        target/bom-build.json: every module with its test scope too, the code that runs in CI.
        Critical findings fail the build. Annotation processors are added by the CI job.
      -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
            <configuration>
              <outputName>bom</outputName>
              <outputFormat>all</outputFormat>
              <projectType>library</projectType>
              <skipNotDeployed>true</skipNotDeployed>
              <includeTestScope>false</includeTestScope>
              <includeProvidedScope>true</includeProvidedScope>
              <includeSystemScope>false</includeSystemScope>
            </configuration>
          </execution>
          <execution>
            <id>sbom-build</id>
            <phase>package</phase>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
            <configuration>
              <outputName>bom-build</outputName>
              <skipAttach>true</skipAttach>
              <outputFormat>json</outputFormat>
              <projectType>library</projectType>
              <skipNotDeployed>false</skipNotDeployed>
              <includeTestScope>true</includeTestScope>
              <includeProvidedScope>true</includeProvidedScope>
              <includeSystemScope>false</includeSystemScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-build-baseline</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <requireProperty>
                  <property>spring-boot.line</property>
                  <regex>^(4\.x|4\.0|3\.5)$</regex>
                  <regexMessage>-Dspring-boot.line must be 4.x (default), 4.0 or 3.5 (TR-EMB-02, ADR-0011).</regexMessage>
                </requireProperty>
                <dependencyConvergence/>
                <banDuplicatePomDependencyVersions/>
                <!--
                  Every plugin of the build lifecycle up to deploy, and the two goals the image build calls
                  by prefix, must have a version from this POM: an unpinned plugin would let a cached and an
                  uncached build run different code. The site lifecycle itself is not used, so it is not checked.
                -->
                <requirePluginVersions>
                  <phases>clean,deploy</phases>
                  <additionalPlugins>
                    <additionalPlugin>org.apache.maven.plugins:maven-dependency-plugin</additionalPlugin>
                    <additionalPlugin>org.apache.maven.plugins:maven-help-plugin</additionalPlugin>
                  </additionalPlugins>
                  <message>Pin every Maven plugin in pluginManagement of the parent POM (reproducible builds, deploy/docker/Dockerfile).</message>
                </requirePluginVersions>
                <!-- TR-LIC-01: a system-scope jar would bypass the licence gate and the SBOM. -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>*:*:*:*:system</exclude>
                  </excludes>
                  <message>System scope is not allowed: the licence gate and the SBOM cannot see it (TR-LIC-01, TR-SEC-06).</message>
                </bannedDependencies>
                <!-- RLE-021: the reference FEEL implementation and its Scala runtime are test scope only, in every module. -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.camunda.feel:*:*:*:compile</exclude>
                    <exclude>org.camunda.feel:*:*:*:runtime</exclude>
                    <exclude>org.camunda.feel:*:*:*:provided</exclude>
                    <exclude>org.scala-lang:*:*:*:compile</exclude>
                    <exclude>org.scala-lang:*:*:*:runtime</exclude>
                    <exclude>org.scala-lang:*:*:*:provided</exclude>
                  </excludes>
                  <message>The reference FEEL implementation is a test-scope oracle (RLE-021); no shipped module may depend on it.</message>
                </bannedDependencies>
                <!-- TR-LIC-02: every jar copies these from the reactor root (.mvn/ marks the root). -->
                <requireFilesExist>
                  <files>
                    <file>${bpm.root}/LICENSE</file>
                    <file>${bpm.root}/COMMERCIAL-LICENSE.md</file>
                  </files>
                  <message>LICENSE and COMMERCIAL-LICENSE.md not found at ${bpm.root}. Build from the repository, which has a .mvn/ directory at its root (TR-LIC-02).</message>
                </requireFilesExist>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      TR-EMB-02, Spring Boot 3.5.x leg. Activated by -Dspring-boot.line=3.5 on a test run of jars built
      on the 4.x baseline, as an adopter receives them (see .github/workflows/ci.yml):
        mvn -B install -DskipTests
        mvn -B -Dspring-boot.line=3.5 surefire:test failsafe:integration-test failsafe:verify
      The tests are not recompiled. Test-only libraries stay on the line they were compiled with.
    -->
    <profile>
      <id>spring-boot-3.5</id>
      <activation>
        <property>
          <name>spring-boot.line</name>
          <value>3.5</value>
        </property>
      </activation>
      <properties>
        <spring-boot.version>${spring-boot-3.5.version}</spring-boot.version>
        <!-- Tests of something that exists on Spring Boot 4 only; none today (the health check is on both lines, #116). -->
        <excludedGroups>spring-boot-4-only</excludedGroups>
        <!-- This profile runs compiled tests only; main code is never recompiled against 3.5. -->
        <maven.main.skip>true</maven.main.skip>
      </properties>
      <build>
        <plugins>
          <!-- The starter's optional Boot-4-only health module stays off a 3.5 host's classpath. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>org.springframework.boot:spring-boot-health</classpathDependencyExclude>
              </classpathDependencyExcludes>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>org.springframework.boot:spring-boot-health</classpathDependencyExclude>
              </classpathDependencyExcludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
      <dependencyManagement>
        <dependencies>
          <!-- Resolved for the starter's optional dependency, then excluded from the test classpath above. -->
          <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-health</artifactId>
            <version>${spring-boot-4.version}</version>
          </dependency>
          <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers-2.version}</version>
          </dependency>
          <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers-2.version}</version>
          </dependency>
          <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers-2.version}</version>
          </dependency>
          <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-jdbc</artifactId>
            <version>${testcontainers-2.version}</version>
          </dependency>
          <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-database-commons</artifactId>
            <version>${testcontainers-2.version}</version>
          </dependency>
          <!-- Spring Boot 3.5 does not manage Jackson 3; the engine core brings this line (ADR-0021). -->
          <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson-3.version}</version>
          </dependency>
          <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson-3.version}</version>
          </dependency>
          <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson-3.version}</version>
          </dependency>
        </dependencies>
      </dependencyManagement>
    </profile>

    <!--
      TR-EMB-02, Spring Boot 4.0.x leg (ADR-0011: every 4.x minor in open-source support). Same method
      as the 3.5 leg; 4.0 has the same starter names as the build line, so only the version changes.
      Drop this profile and its CI leg after 4.0 leaves open-source support on 2026-12-31.
    -->
    <profile>
      <id>spring-boot-4.0</id>
      <activation>
        <property>
          <name>spring-boot.line</name>
          <value>4.0</value>
        </property>
      </activation>
      <properties>
        <spring-boot.version>${spring-boot-4.0.version}</spring-boot.version>
        <maven.main.skip>true</maven.main.skip>
      </properties>
    </profile>
  </profiles>
</project>

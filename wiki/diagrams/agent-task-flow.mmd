flowchart TB
  I["agentTask reached\nresolve bounded inputs, mask flagged fields"] --> W["Async Wait-State\nTX1 claim lease, commit, call adapter"]
  W --> O{"Output received\nwithin timeout?"}
  O -->|"no: timeout or adapter error"| R{"attempt < retry.max?"}
  O -->|"yes"| V{"Validates against\noutputSchema?"}
  V -->|"no: AGENT_SCHEMA_INVALID"| R
  V -->|"yes"| G["RuleEngine.evaluate\n(guardrail rule set, output)"]
  G -->|"allow"| N["Advance token\nhistory: output, guardrailDecisionId, latency"]
  G -->|"violation, onViolation route-to-human"| H["Approval userTask\ncarries output and matched rule ids\nmaker-checker: agent requester excluded"]
  G -->|"violation, onViolation fail"| F["Incident AGENT_GUARDRAIL_FAILED\nor compensation"]
  R -->|"yes"| W
  R -->|"no"| F
  H -->|"approve or edit"| N
  H -->|"reject"| F

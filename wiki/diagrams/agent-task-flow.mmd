flowchart TB
  I["1. agentTask reached<br/>resolve bounded inputs, mask flagged fields"] -->|"2."| W["Async wait-state<br/>TX1: claim lease, commit"]
  W -->|"3. call outside any transaction"| AD["Host adapter<br/>calls the agent under timeout"]
  AD --> O{"Output received<br/>within timeout?"}
  O -->|"no: timeout or adapter error"| R{"attempt < retry.max?"}
  O -->|"4. yes, TX2"| V{"Validates against<br/>outputSchema?"}
  V -->|"no: AGENT_SCHEMA_INVALID"| R
  V -->|"5. yes"| G["RuleEngine.evaluate<br/>(guardrail rule set, output)"]
  G -->|"6a. allow"| N["Advance token<br/>history: output, guardrailDecisionId, latency"]
  G -->|"6b. violation, route-to-human"| H["Approval userTask<br/>carries output and matched rule ids<br/>the triggering identity cannot approve"]
  G -->|"6c. violation, fail"| F["Incident or compensation"]
  R -->|"yes"| W
  R -->|"no"| F
  H -->|"approve or edit"| N
  H -->|"reject"| F

  classDef client fill:#E3F2FD,stroke:#1565C0,color:#16231F

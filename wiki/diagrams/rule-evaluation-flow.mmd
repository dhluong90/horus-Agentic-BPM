flowchart LR
  subgraph Authoring["Authoring: once per version"]
    D["Definition\nYAML, JSON or cockpit"] --> V["Validate\ntypes, names, overlaps"]
    V --> C["Compile\nexpressions to typed tree, slot indices"]
    C --> S[("rle_version\ncanonical JSON + hash")]
  end
  subgraph Evaluation["Evaluation: every call, no I/O"]
    I["DecisionInput\nvalues, clock, tenant"] --> R["Resolve version\neffective at clock"]
    S -->|"compiled cache per replica\ninvalidated by NOTIFY + epoch"| R
    R --> E["Evaluate\npure, p99 target under 100 us"]
    E --> O["DecisionResult\noutputs, matched rules"]
    E --> L[("rle_decision\nappend-only, one INSERT")]
  end

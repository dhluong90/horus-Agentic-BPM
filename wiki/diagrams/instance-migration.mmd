flowchart LR
  V1[("definition v1\n5 000 running instances")] --> P["migration plan\nv1 to v2, step mapping"]
  P --> D["dry run (:validate)\ninstances per step,\nunmapped steps, conflicts"]
  D -->|"plan valid"| X["execute (:execute)\nbatches of 100; per instance: lock row,\nremap tokens, pin v2, history row"]
  D -->|"conflicts"| F["fix mapping\nor cancel instances"]
  F --> D
  X --> V2[("definition v2\nall instances migrated")]
  X -. "per-instance failure" .-> I[["incident on that instance\nothers continue"]]

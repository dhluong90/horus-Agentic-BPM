flowchart LR
  V1[("definition v1<br/>5 000 running instances")] -->|"1."| P["migration plan<br/>v1 to v2, step mapping"]
  P -->|"2."| D["dry run (:validate)<br/>instances per step,<br/>unmapped steps, conflicts"]
  D -->|"3a. plan valid"| X["execute (:execute)<br/>batches of 100; per instance: lock row,<br/>remap tokens, pin v2, history row"]
  D -->|"3b. conflicts"| F["fix mapping<br/>or cancel instances"]
  F -->|"back to 2."| D
  X -->|"4."| V2[("definition v2<br/>all instances migrated")]
  X -. "per-instance failure" .-> I[["incident on that instance<br/>others continue"]]

  classDef client fill:#E3F2FD,stroke:#1565C0,color:#16231F
  classDef host fill:#E8F5E9,stroke:#2E7D32,color:#16231F
  classDef engine fill:#E0F2F1,stroke:#00796B,stroke-width:2px,color:#16231F
  classDef db fill:#FFF8E1,stroke:#F9A825,color:#16231F
  classDef external fill:#F3E5F5,stroke:#6A1B9A,color:#16231F
  classDef obs fill:#ECEFF1,stroke:#546E7A,color:#16231F
  class V1,V2 db
  class P,D,X engine
  class F client
  class I obs

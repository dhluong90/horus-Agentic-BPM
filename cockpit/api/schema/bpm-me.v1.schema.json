{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:horus-bpm:schema:bpm-me:v1",
  "title": "Response of GET /api/bpm/me, schema version 1",
  "description": "The caller as this host sees it, for the tenant the request resolved to. The cockpit hides what the caller cannot do; every endpoint still enforces its own permission.",
  "type": "object",
  "required": ["schemaVersion", "user", "tenant", "permissions"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "user": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" }
      }
    },
    "tenant": {
      "type": "object",
      "required": ["current", "allowed"],
      "properties": {
        "current": { "type": "string", "minLength": 1 },
        "allowed": {
          "description": "Tenants the caller may select with X-Tenant-Id: the allowed-tenants claim when switching is enabled, otherwise only the current tenant.",
          "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" }
        }
      }
    },
    "permissions": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(rules|processes)(:[a-z]+){1,2}$" }
    },
    "roles": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "groups": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  }
}

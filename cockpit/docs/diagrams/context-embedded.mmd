flowchart LR
  subgraph PZ["Public Zone"]
    BR["Operator browser<br/>embedded cockpit"]:::client
  end
  subgraph DMZ["Banking DMZ"]
    GW["API gateway and WAF"]:::host
  end
  subgraph IZ["Internal Trusted Zone"]
    IDP["Bank identity provider"]:::host
    subgraph H["Host service, any replica"]
      SEC["Host Spring Security<br/>session or bearer"]:::host
      ST["cockpit-spring-boot-starter<br/>/bpm/cockpit assets and config"]:::engine
      REST["/api/bpm/rules/v1<br/>/api/bpm/processes/v1"]:::engine
    end
    DB[("Host PostgreSQL")]:::db
  end
  subgraph OZ["Observability"]
    LOG["Host logs and metrics"]:::obs
  end
  BR -->|"1. HTTPS /bpm/cockpit"| GW
  GW -->|"2. same origin"| SEC
  SEC -->|"3. host login flow"| IDP
  SEC -->|"4. authenticated assets, CSP, no-store"| ST
  BR -->|"5. API calls with session cookie and X-XSRF-TOKEN"| GW
  GW --> REST
  REST -->|"6. host DataSource"| DB
  REST -.->|"7. logs, metrics"| LOG
  classDef client fill:#E3F2FD,stroke:#1565C0,color:#16231F
  classDef host fill:#E8F5E9,stroke:#2E7D32,color:#16231F
  classDef engine fill:#E0F2F1,stroke:#00796B,stroke-width:2px,color:#16231F
  classDef db fill:#FFF8E1,stroke:#F9A825,color:#16231F
  classDef external fill:#F3E5F5,stroke:#6A1B9A,color:#16231F
  classDef obs fill:#ECEFF1,stroke:#546E7A,color:#16231F
  style PZ fill:none,stroke:#9E9E9E,stroke-dasharray:5 5
  style DMZ fill:none,stroke:#EF6C00,stroke-dasharray:5 5
  style IZ fill:none,stroke:#1565C0,stroke-dasharray:5 5
  style OZ fill:none,stroke:#546E7A,stroke-dasharray:5 5
  style H fill:none,stroke:#2E7D32

flowchart LR
  subgraph T1["Tier 1: workspace and context"]
    CTX["Top bar: host, tenant,<br/>environment banner, user"]:::client
    NAV["Menu: Home, Rules, Approvals,<br/>Decisions, Processes; Inbox and<br/>Incidents from M2"]:::client
  end
  subgraph T2["Tier 2: queues and lists, counts in the header"]
    QI["Inbox: merged tasks by due date"]:::client
    QN["Incidents: merged by age"]:::client
    QD["Definitions and instances"]:::client
    QR["Rule sets and decisions"]:::client
    QA["Pending approvals: rules, processes"]:::client
  end
  subgraph T3["Tier 3: detail and action"]
    DT["Task form, complete or link"]:::client
    DI["Instance diagram, tokens, activities"]:::client
    DN["Incident detail, retry, resolve"]:::client
    DV["Version diff, simulation, approve"]:::client
    DM["Definition diagram, graph diff,<br/>modeller in M3"]:::client
    DA["Agent task inspector"]:::client
  end

# LOCAL EVALUATION ONLY, NOT A PRODUCTION DEPLOYMENT (docs/DEPLOYING.md).
# Copy to .env (git ignores it) and fill in the values: cp .env.example .env
# docker compose reads .env from this folder. Never commit .env or put a real password in this file.

# Password of the PostgreSQL superuser "postgres", used only to create the database on the first start.
# Required. The host never receives it.
HORUS_DB_ADMIN_PASSWORD=

# Password of "horus", the role the host connects with: owner of the database horus, not a superuser.
# Required. PostgreSQL keeps both passwords from the first start: after changing one, run
# "docker compose down -v" to recreate the database (this deletes its data).
HORUS_DB_PASSWORD=

# NOT FOR PRODUCTION: "dev" turns on demo users who share one password (docs/DEPLOYING.md). Leave it empty on any
# machine other than your own; then only /actuator/health answers until a token issuer is configured.
SPRING_PROFILES_ACTIVE=dev

# Password of the demo users on the dev profile. Without it nobody can sign in.
HORUS_DEMO_PASSWORD=

# Example host to build and run, a folder under examples/.
HORUS_EXAMPLE=rule-engine-only

# Port on this machine (127.0.0.1) that serves the host.
HORUS_HTTP_PORT=8080

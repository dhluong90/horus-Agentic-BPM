# LOCAL EVALUATION ONLY, NOT A PRODUCTION DEPLOYMENT (docs/DEPLOYING.md).
# Copy to .env (git ignores it): cp .env.example .env
# docker compose reads .env from this folder. It holds settings only: the passwords are files in secrets/,
# created by deploy/create-secrets.sh and mounted into the containers. Never put a password in this file.

# Empty by default: then only /actuator/health answers until a token issuer is configured. For a local walkthrough set
# it to dev, which turns on demo users who share one password. NOT FOR PRODUCTION (docs/DEPLOYING.md).
SPRING_PROFILES_ACTIVE=

# Example host to build and run, a folder under examples/.
HORUS_EXAMPLE=rule-engine-only

# Port on this machine (127.0.0.1) that serves the host.
HORUS_HTTP_PORT=8080

# Two database roles (docs/DEPLOYING.md, "Two database roles"): the compose service "migrate" runs as horus_owner, migrates
# and ends; the service "host" serves requests as horus and never receives the owner's password. The passwords are the
# files secrets/db_owner_password and secrets/db_password. For your own database, run the migration step once per
# upgrade with HORUS_BPM_MIGRATE_ONLY=true and the owner as HORUS_DB_USERNAME / HORUS_DB_PASSWORD, plus
# HORUS_BPM_RULES_DATABASE_APP_ROLE and HORUS_BPM_PROCESSES_DATABASE_APP_ROLE; give the serving hosts the application role
# only, with SPRING_FLYWAY_ENABLED=false and HORUS_BPM_*_MIGRATE_ON_START=false.
# Outside the dev profile the host refuses a role that owns the tables (HORUS-DB-ROLE-001). One role that owns the tables
# runs only under dev, for development; it is not for production.

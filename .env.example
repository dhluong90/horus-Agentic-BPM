# LOCAL EVALUATION ONLY, NOT A PRODUCTION DEPLOYMENT (docs/DEPLOYING.md).
# Copy to .env (git ignores it): cp .env.example .env
# docker compose reads .env from this folder. It holds settings only: the passwords are files in secrets/,
# created by deploy/create-secrets.sh and mounted into the containers. Never put a password in this file.

# Empty by default: then only /actuator/health answers until a token issuer is configured. For a local walkthrough set
# it to dev, which turns on demo users who share one password. NOT FOR PRODUCTION (docs/DEPLOYING.md).
SPRING_PROFILES_ACTIVE=

# Example host to build and run, a folder under examples/.
HORUS_EXAMPLE=rule-engine-only

# Port on this machine (127.0.0.1) that serves the host.
HORUS_HTTP_PORT=8080

# Two database roles (docs/DEPLOYING.md, "Two database roles"): compose runs the migrations as horus_owner and serves
# requests as horus, which owns nothing. Their names are set in docker-compose.yml; their passwords are the files
# secrets/db_owner_password and secrets/db_password. For your own database set, on the host:
#   HORUS_DB_USERNAME / HORUS_DB_PASSWORD                          the application role
#   SPRING_FLYWAY_URL / SPRING_FLYWAY_USER / SPRING_FLYWAY_PASSWORD the owner, for the host's own migrations
#   HORUS_BPM_RULES_DATABASE_OWNER_URL / _OWNER_USERNAME / _OWNER_PASSWORD / _APP_ROLE / _ROLE_CHECK
#   HORUS_BPM_PROCESSES_DATABASE_OWNER_URL / _OWNER_USERNAME / _OWNER_PASSWORD / _APP_ROLE / _ROLE_CHECK
# One role that owns the tables (nothing above set) still runs, for development only; it is not for production.

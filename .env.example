# Copy to .env (git ignores it) and fill in the values: cp .env.example .env
# docker compose reads .env from this folder. Never commit .env or put a real password in this file.

# Password of the PostgreSQL user "horus". Required. PostgreSQL keeps the value it was first started
# with: after changing it, run "docker compose down -v" to recreate the database (this deletes its data).
HORUS_DB_PASSWORD=

# Local walkthrough only: "dev" turns on the demo users (docs/DEPLOYING.md). Leave it empty on any
# machine other than your own; then only /actuator/health answers until a token issuer is configured.
SPRING_PROFILES_ACTIVE=dev

# Password of the demo users on the dev profile. Without it nobody can sign in.
HORUS_DEMO_PASSWORD=

# Example host to build and run, a folder under examples/.
HORUS_EXAMPLE=rule-engine-only

# Port on this machine (127.0.0.1) that serves the host.
HORUS_HTTP_PORT=8080

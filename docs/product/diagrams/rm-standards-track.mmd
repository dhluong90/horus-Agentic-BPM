flowchart LR
  subgraph S0 ["Foundations (M1 to M3)"]
    direction TB
    F1["M1 rules: source document, time zone,<br/>FEEL-aligned semantics and nulls, DMN-shaped rule set,<br/>semantic model canonical<br/>RE-F-38 to RE-F-42, X-F-28"]
    F2["M2 processes: source document, BPMN ids,<br/>business errors, job cancel, scope tokens,<br/>BPMN-typed nodes, semantic model canonical<br/>PE-F-54 to PE-F-58, CK-F-40, X-F-28"]
    F3["M3: ADR-0013 subset import and export;<br/>DMN single table; refused by name; no CMMN<br/>PE-F-41, PE-F-53, RE-F-30, X-F-25"]
    F1 --> F2 --> F3
  end
  subgraph T1 ["1.0 baseline: BPMN 2.0 Common Executable"]
    direction TB
    B1["Every executable element: subprocesses, boundary and event<br/>subprocesses, gateways incl. complex, multi-instance, ad-hoc,<br/>multiple events, messages, signals, compensation<br/>PE-F-40, PE-F-59 to PE-F-66"]
    B2["Pools, lanes, message flows displayed; import from standard modellers<br/>CK-F-41, CK-F-42"]
  end
  subgraph T2 ["After 1.0: DMN and evidence"]
    direction TB
    D1["DMN Levels 2 and 3, full FEEL, DMNDI<br/>RE-F-43 to RE-F-47"]
    R1["Deviation register, conformance evidence<br/>X-F-26, X-F-27"]
  end
  F3 --> B1
  B1 --> B2
  B2 -. "no dates" .-> D1
  D1 --> R1


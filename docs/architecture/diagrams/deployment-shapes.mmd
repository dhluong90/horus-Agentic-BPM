flowchart TB
  subgraph One["Single service"]
    direction LR
    S1["Service with engines<br/>cockpit at /bpm/cockpit"] --> D1[("PostgreSQL")]
  end
  subgraph Many["Several services, one cockpit"]
    direction LR
    C2["Standalone cockpit<br/>CORS allowlist on each host"] --> S2a["Service A<br/>Rule Engine"]
    C2 --> S2b["Service B<br/>both engines"]
    S2a --> D2a[("Database A")]
    S2b --> D2b[("Database B")]
  end
  subgraph Replicas["Replicas of one service"]
    direction LR
    R1["Replica 1"] --> D3[("Shared PostgreSQL<br/>jobs: SKIP LOCKED leases<br/>joins: instance row lock<br/>caches: cache_epoch and NOTIFY")]
    R2["Replica 2"] --> D3
    R3["Replica 3"] --> D3
  end

  classDef client fill:#E3F2FD,stroke:#1565C0,color:#16231F
  classDef host fill:#E8F5E9,stroke:#2E7D32,color:#16231F
  classDef engine fill:#E0F2F1,stroke:#00796B,stroke-width:2px,color:#16231F
  classDef db fill:#FFF8E1,stroke:#F9A825,color:#16231F
  classDef external fill:#F3E5F5,stroke:#6A1B9A,color:#16231F
  classDef obs fill:#ECEFF1,stroke:#546E7A,color:#16231F
  class C2 client
  class S1,S2a,S2b,R1,R2,R3 host
  class D1,D2a,D2b,D3 db

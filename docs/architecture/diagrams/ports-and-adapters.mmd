flowchart LR
  subgraph In["Inbound adapters"]
    direction TB
    J["Host Java code"]
    R["*-rest controllers"]
    S["Scheduler thread<br/>(starter)"]
  end
  subgraph Core["*-core: functional core"]
    direction TB
    IP["Inbound ports<br/>RuleEngine, VersionService<br/>ProcessEngine, TaskService,<br/>MigrationService"]
    D["Domain<br/>sealed Expr tree, CompiledRuleSet,<br/>token runtime, state machines,<br/>Money, ULID"]
    OP["Outbound ports<br/>storage, CompiledCache, Clock,<br/>TenantResolver, CallerResolver,<br/>event publisher, RuleFunctionRegistry,<br/>AgentAdapter, ServiceAdapter,<br/>BusinessCalendar, OutputSchemaValidator"]
    IP --> D
    D --> OP
  end
  subgraph Out["Outbound adapters"]
    direction TB
    P["*-postgres<br/>JdbcClient, Flyway, SKIP LOCKED,<br/>LISTEN/NOTIFY"]
    H["Host beans<br/>security, events, adapters, calendar"]
    T["*-test<br/>in-memory ports, fixed Clock"]
  end
  J --> IP
  R --> IP
  S --> IP
  OP -.->|"implemented by"| P
  OP -.->|"implemented by"| H
  OP -.->|"implemented by"| T

  classDef client fill:#E3F2FD,stroke:#1565C0,color:#16231F
  classDef host fill:#E8F5E9,stroke:#2E7D32,color:#16231F
  classDef engine fill:#E0F2F1,stroke:#00796B,stroke-width:2px,color:#16231F
  classDef db fill:#FFF8E1,stroke:#F9A825,color:#16231F
  classDef external fill:#F3E5F5,stroke:#6A1B9A,color:#16231F
  classDef obs fill:#ECEFF1,stroke:#546E7A,color:#16231F
  class J,R,S host
  class IP,D,OP engine
  class P db
  class H host
  class T obs

sequenceDiagram
  autonumber
  box rgb(224,242,241) Process Engine in replica A
    participant S as Scheduler thread
    participant W as Adapter executor
  end
  box rgb(255,248,225) Host PostgreSQL
    participant DB as pre_timer, pre_token, pre_history
  end
  box rgb(243,229,245) Core and External
    participant X as Agent or remote service
  end
  rect rgb(255,248,225)
    Note over S,DB: TX1, sync, under 5 ms: claim only when an executor slot is free
    S->>DB: SELECT due jobs FOR UPDATE SKIP LOCKED LIMIT free_slots
    S->>DB: UPDATE status CLAIMED, locked_by A, locked_until now() + timeout + 30 s, attempt + 1
    S->>DB: COMMIT
  end
  rect rgb(243,229,245)
    Note over W,X: No transaction, no connection, no row lock
    S->>W: submit(invocation, attemptId)
    W->>X: call with timeout, attemptId as idempotency key
    alt returns in time
      X-->>W: structured output
    else timeout or transport error
      W-->>W: cancel the call, failed attempt
    end
  end
  rect rgb(255,248,225)
    Note over W,DB: TX2, sync, fresh transaction
    W->>DB: SELECT job WHERE locked_by A AND status CLAIMED AND locked_until > now() FOR UPDATE
    alt lease held, output valid, guardrail allow
      W->>DB: history row, advance token, job DONE, events
    else guardrail denies, route-to-human
      W->>DB: approval task with output and matched rules
    else failed, attempts left
      W->>DB: status DUE, next_fire_at now() + backoff
    else failed, attempts exhausted
      W->>DB: open incident, or start compensation
    else lease expired or taken over
      W->>DB: ROLLBACK, late result discarded
    else job CANCELLED (instance cancelled or migrated off the step)
      W->>DB: history LATE_RESULT_DISCARDED with attemptId, nothing else
    end
    W->>DB: COMMIT
  end

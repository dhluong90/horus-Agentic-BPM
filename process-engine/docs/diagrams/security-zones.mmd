flowchart LR
  subgraph PZ["Public Zone"]
    OP["Operator browser<br/>cockpit static assets"]:::client
    CH["Customer channel<br/>web or mobile"]:::client
  end
  subgraph DMZ["Banking DMZ"]
    GW["API gateway and WAF<br/>TLS, rate limits"]:::host
  end
  subgraph IZ["Internal Trusted Zone"]
    IDP["Bank identity provider<br/>OIDC"]:::host
    subgraph HOST["Host Spring Boot service, one JVM per replica"]
      APP["Host business code"]:::host
      REST["Process REST layer<br/>/api/bpm/processes/v1"]:::engine
      PE[["Process Engine<br/>process-engine-core"]]:::engine
      RE[["Rule Engine API<br/>decision and guardrail"]]:::engine
      SCH["Scheduler thread<br/>jobs, timers, rollup"]:::engine
      ADP["Host adapters<br/>ServiceAdapter, AgentAdapter"]:::host
    end
    DB[("Host PostgreSQL<br/>host tables and pre_*")]:::db
  end
  subgraph CZ["Core and External"]
    CORE["Core banking, partners"]:::external
    AI["Model or agent API, MCP tools"]:::external
  end
  subgraph OZ["Observability"]
    OBS["Metrics, traces, logs"]:::obs
    SINK["Host event sink and outbox"]:::obs
  end
  CH -->|"1. HTTPS business request"| GW
  OP -->|"2. HTTPS, bearer token"| GW
  GW -->|"3. verified request"| APP
  GW -->|"4. verified request"| REST
  REST -.->|"5. token validation keys"| IDP
  APP -->|"6. ProcessEngine API, joins host TX"| PE
  REST --> PE
  PE -->|"7. in-process, same TX"| RE
  PE -->|"8. JDBC, host DataSource"| DB
  SCH -->|"9. TX1 claim with lease"| DB
  SCH -->|"10. after TX1 commit, no connection held"| ADP
  ADP -->|"11. bounded timeout, attemptId"| CORE
  ADP -->|"11. bounded timeout, attemptId"| AI
  PE -.->|"12. events inside the state TX"| SINK
  PE -.->|"13. Micrometer, OpenTelemetry"| OBS
  classDef client fill:#E3F2FD,stroke:#1565C0,color:#16231F
  classDef host fill:#E8F5E9,stroke:#2E7D32,color:#16231F
  classDef engine fill:#E0F2F1,stroke:#00796B,stroke-width:2px,color:#16231F
  classDef db fill:#FFF8E1,stroke:#F9A825,color:#16231F
  classDef external fill:#F3E5F5,stroke:#6A1B9A,color:#16231F
  classDef obs fill:#ECEFF1,stroke:#546E7A,color:#16231F
  style PZ fill:none,stroke:#9E9E9E,stroke-dasharray:5 5
  style DMZ fill:none,stroke:#EF6C00,stroke-dasharray:5 5
  style IZ fill:none,stroke:#1565C0,stroke-dasharray:5 5
  style CZ fill:none,stroke:#6A1B9A,stroke-dasharray:5 5
  style OZ fill:none,stroke:#546E7A,stroke-dasharray:5 5
  style HOST fill:none,stroke:#2E7D32

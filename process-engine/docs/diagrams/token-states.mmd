stateDiagram-v2
  direction LR
  state "Scope tokens (kind SCOPE)" as SCOPES {
    state "COMPLETED" as SCOPE_COMPLETED
    state "COMPENSATED" as SCOPE_COMPENSATED
    state "CANCELLED" as SCOPE_CANCELLED
    [*] --> WAITING_SCOPE: instance start or saga entered
    WAITING_SCOPE --> SCOPE_COMPLETED: last FLOW token under it completed
    WAITING_SCOPE --> SCOPE_COMPENSATED: its stack compensated
    WAITING_SCOPE --> SCOPE_CANCELLED: instance cancelled or migrated off the saga
    SCOPE_COMPLETED --> SCOPE_COMPENSATED: throwCompensation later
  }
  state "Flow tokens (kind FLOW)" as FLOWS {
    [*] --> ACTIVE: start, fork or scope entered
    ACTIVE --> WAITING_USER: userTask created
    WAITING_USER --> ACTIVE: task completed
    ACTIVE --> WAITING_ASYNC: TX1 claims async job
    WAITING_ASYNC --> ACTIVE: TX2 accepts result
    WAITING_ASYNC --> WAITING_ASYNC: business error or memory failure, incident opened
    ACTIVE --> WAITING_TIMER: timer step
    WAITING_TIMER --> ACTIVE: timer fires
    ACTIVE --> JOINED: arrives at join, instance row locked, counted per scope token
    JOINED --> COMPLETED: set complete, one new ACTIVE token leaves the join
    ACTIVE --> COMPLETED: end of its scope
    COMPLETED --> COMPENSATED: compensation of its steps ran
    WAITING_USER --> CANCELLED: instance cancelled or migrated off the step
    WAITING_ASYNC --> CANCELLED: instance cancelled, job CANCELLED
    WAITING_TIMER --> CANCELLED: instance cancelled
    ACTIVE --> CANCELLED: instance cancelled
  }
  classDef engine fill:#E0F2F1,stroke:#00796B,stroke-width:2px,color:#16231F
  classDef host fill:#E8F5E9,stroke:#2E7D32,color:#16231F
  classDef client fill:#E3F2FD,stroke:#1565C0,color:#16231F
  classDef external fill:#F3E5F5,stroke:#6A1B9A,color:#16231F
  classDef obs fill:#ECEFF1,stroke:#546E7A,color:#16231F
  class ACTIVE engine
  class WAITING_SCOPE host
  class WAITING_USER client
  class WAITING_ASYNC,WAITING_TIMER external
  class JOINED,COMPLETED,COMPENSATED,CANCELLED,SCOPE_COMPLETED,SCOPE_COMPENSATED,SCOPE_CANCELLED obs

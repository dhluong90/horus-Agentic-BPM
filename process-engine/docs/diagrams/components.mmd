flowchart TB
  subgraph STARTER["process-engine-spring-boot-starter"]
    AC["Auto-configuration<br/>profile guards, scheduler lifecycle"]:::host
  end
  subgraph RESTM["process-engine-rest"]
    CTRL["Controllers /api/bpm/processes/v1<br/>RFC 9457, ETag, Idempotency-Key"]:::engine
  end
  subgraph CORE["process-engine-core, no Spring, SQL or network"]
    direction TB
    API["api: ProcessEngine, DefinitionService,<br/>TaskService, ProcessQueryService, StepCatalogue"]:::engine
    DOM["Domain: Definition aggregate and lifecycle,<br/>Instance and token tree, Task, GraphDiff"]:::engine
    PORTS["Driven ports: DefinitionStore, LayoutStore,<br/>InstanceStore, JobQueue, HistoryLog, StatsReadModel"]:::engine
    SPI["spi: ServiceAdapter, AgentAdapter, StepRegistry,<br/>BusinessCalendar, TenantResolver, CallerResolver,<br/>ProcessEventPublisher, FormRegistry"]:::engine
  end
  subgraph BPMN["process-engine-bpmn"]
    STAX["BPMN subset reader and writer<br/>JDK StAX only"]:::engine
  end
  subgraph PG["process-engine-postgres"]
    JDBC["JdbcClient adapters, Flyway pre_*,<br/>SKIP LOCKED poller, rollup job"]:::engine
  end
  subgraph TEST["process-engine-test"]
    MEM["In-memory adapters, TestClock,<br/>StubAgentAdapter, @ProcessTest"]:::engine
  end
  RULES[["Rule Engine API<br/>optional bean"]]:::engine
  HOSTC["Host beans: adapters, calendars,<br/>resolvers, event publisher"]:::host
  DB[("Host PostgreSQL")]:::db
  AC --> CTRL
  AC --> JDBC
  CTRL -->|"1. calls"| API
  API --> DOM
  DOM -->|"2. uses"| PORTS
  DOM -->|"3. uses"| SPI
  STAX -->|"4. produces definition and layout"| API
  JDBC -.->|"5. implements"| PORTS
  MEM -.->|"5. implements"| PORTS
  HOSTC -.->|"6. implements"| SPI
  DOM -->|"7. decision, guardrail"| RULES
  JDBC -->|"8. JDBC"| DB

<?xml version="1.0" encoding="UTF-8"?>
<!-- A loan booking that withdraws one step by a compensation throw event that names it (#488): the funds reservation
     is undone and nothing else; a second throw of the same name finds nothing left to undo, and the flow goes on. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:horus="urn:horus-bpm:bpmn:extensions:v1"
                  id="Definitions_loan-undo-one"
                  targetNamespace="urn:horus-bpm:examples"
                  expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:process id="loan-undo-one" name="Loan booking, one step withdrawn" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:serviceTask id="register-loan" horus:handler="register-loan" horus:compensate="cancel-loan"/>
    <bpmn:serviceTask id="reserve-funds" horus:handler="reserve-funds" horus:compensate="release-funds"/>
    <bpmn:serviceTask id="open-account" horus:handler="open-account" horus:compensate="close-account"/>
    <bpmn:intermediateThrowEvent id="withdraw-reservation" name="Withdraw the reservation">
      <bpmn:compensateEventDefinition activityRef="reserve-funds"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="withdraw-again" name="Withdraw it again">
      <bpmn:compensateEventDefinition activityRef="reserve-funds"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="register-loan"/>
    <bpmn:sequenceFlow id="f2" sourceRef="register-loan" targetRef="reserve-funds"/>
    <bpmn:sequenceFlow id="f3" sourceRef="reserve-funds" targetRef="open-account"/>
    <bpmn:sequenceFlow id="f4" sourceRef="open-account" targetRef="withdraw-reservation"/>
    <bpmn:sequenceFlow id="f5" sourceRef="withdraw-reservation" targetRef="withdraw-again"/>
    <bpmn:sequenceFlow id="f6" sourceRef="withdraw-again" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<!-- KYC onboarding (#98): an agent reads the customer's identity document and answers its type, its expiry date and
     how confident it is. The bank's kyc-document-guardrails rule set sends a low-confidence or expired answer to a KYC
     reviewer. The national id reaches the agent as a masked input, and the free-text summary is masked in history. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:horus="urn:horus-bpm:bpmn:extensions:v1"
                  id="Definitions_kyc-onboarding"
                  targetNamespace="urn:horus-bpm:examples"
                  expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:process id="kyc-onboarding" name="KYC onboarding" isExecutable="true">
    <bpmn:startEvent id="start" name="Documents uploaded"/>
    <bpmn:serviceTask id="assess-documents" name="Assess the identity document" horus:type="agentTask"
                      horus:agent="documents.kyc" horus:timeout="PT5S" horus:resultVariable="assessment">
      <bpmn:extensionElements>
        <horus:input name="customerId" value="${instance.customerId}"/>
        <horus:input name="nationalId" value="${instance.nationalId}" mask="true"/>
        <horus:outputSchema>{
          "type": "object",
          "required": ["documentType", "confidence", "expiryDate"],
          "additionalProperties": false,
          "properties": {
            "documentType": {"type": "string", "enum": ["PASSPORT", "ID_CARD", "UNKNOWN"]},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "expiryDate": {"type": "string", "maxLength": 10},
            "summary": {"type": "string", "maxLength": 500, "mask": true}
          }
        }</horus:outputSchema>
        <horus:guardrail decision="kyc-document-guardrails" onViolation="route-to-human" reviewer="role:KYC_REVIEWER"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="open-account" name="Open the account" horus:assignee="role:ACCOUNT_OFFICER" horus:resultVariable="account"/>
    <bpmn:endEvent id="end" name="Onboarded"/>
    <bpmn:sequenceFlow id="start__assess" sourceRef="start" targetRef="assess-documents"/>
    <bpmn:sequenceFlow id="assess__open" sourceRef="assess-documents" targetRef="open-account"/>
    <bpmn:sequenceFlow id="open__end" sourceRef="open-account" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>

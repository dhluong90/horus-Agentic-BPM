<?xml version="1.0" encoding="UTF-8"?>
<!-- A loan application's documents are assessed by an automated assessor that answers in seconds or calls back later.
     Its answer is checked against an output schema and the bank's guardrail rule set before the loan moves on to
     underwriting; a refused answer goes to a compliance reviewer. Until the agent step type exists, the tests run this
     step's job as a stub agent job (ASYNC_AGENT) with the guard spec in its payload. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:horus="urn:horus-bpm:bpmn:extensions:v1"
                  id="Definitions_loan-document-assessment"
                  targetNamespace="urn:horus-bpm:examples"
                  expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:process id="loan-document-assessment" name="Loan document assessment" isExecutable="true">
    <bpmn:startEvent id="start" name="Documents received"/>
    <bpmn:serviceTask id="assess-documents" name="Assess the documents" horus:handler="documents.assess"
                      horus:mode="remote" horus:timeout="PT5S" horus:resultVariable="assessment">
      <bpmn:extensionElements>
        <horus:input name="applicationId" value="${instance.applicationId}"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="underwrite" name="Underwrite the loan" horus:assignee="role:UNDERWRITER" horus:resultVariable="decision"/>
    <bpmn:endEvent id="end" name="Decided"/>
    <bpmn:sequenceFlow id="start__assess" sourceRef="start" targetRef="assess-documents"/>
    <bpmn:sequenceFlow id="assess__underwrite" sourceRef="assess-documents" targetRef="underwrite"/>
    <bpmn:sequenceFlow id="underwrite__end" sourceRef="underwrite" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>

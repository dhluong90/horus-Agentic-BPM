{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:horus-bpm:schema:task-form:v1",
  "title": "HORUS Process Engine resolved task form, schema version 1",
  "description": "Response of GET /api/bpm/processes/v1/tasks/{id}/form. Either a form (a JSON Schema for the result, display hints and prefilled data) or a link to the host's own screen. The engine validates the result of :complete against the same schema (422 FORM_VALIDATION_FAILED).",
  "type": "object",
  "required": ["schemaVersion", "taskId", "lockVersion"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "lockVersion": { "type": "integer", "minimum": 0 },
    "form": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "description": "JSON Schema 2020-12 for the task result. Supported field types: string, integer, number, boolean, enum, date, date-time and the money object {currency, amount}.",
          "type": "object"
        },
        "hints": { "$ref": "#/$defs/hints" },
        "data": {
          "description": "Prefilled values from declared variables. Masked fields are returned as masked placeholders, never in clear.",
          "type": "object"
        }
      }
    },
    "link": {
      "description": "Resolved link to the host's own screen; relative, or on an origin listed in tasks.form-link-origins.",
      "type": "string",
      "maxLength": 2000
    }
  },
  "oneOf": [ { "required": ["form"] }, { "required": ["link"] } ],
  "$defs": {
    "texts200": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "texts300": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "texts30": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 30 } },
    "hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "maxItems": 200 },
        "widgets": {
          "type": "object",
          "additionalProperties": { "enum": ["text", "textarea", "select", "radio", "checkbox", "date", "datetime", "money", "readonly"] }
        },
        "labels": {
          "description": "Per field, per locale, for example { \"reason\": { \"en\": \"Reason\", \"vi\": \"Lý do\" } }.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
            "additionalProperties": { "type": "string", "maxLength": 200 }
          }
        },
        "readOnly": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "options": {
          "description": "PRE-393. Per enum field, per value, a label per locale and an optional one-line consequence per locale. The value itself never changes; only what the screen shows.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["label"],
              "additionalProperties": false,
              "properties": {
                "label": { "$ref": "#/$defs/texts200" },
                "consequence": { "$ref": "#/$defs/texts300" }
              }
            }
          }
        },
        "units": {
          "description": "PRE-393. Per field, a suffix per locale shown after the value, for example { \"termMonths\": { \"en\": \"months\", \"vi\": \"tháng\" } }.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/texts30" }
        },
        "formats": {
          "description": "PRE-393. Per field, display of a number or money amount: grouping of thousands by the viewer's locale and a fixed currency or the name of a field that holds it. Stored values never change.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "grouping": { "type": "boolean" },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
              "currencyFrom": { "type": "string" }
            },
            "not": { "required": ["currency", "currencyFrom"] }
          }
        }
      }
    }
  }
}

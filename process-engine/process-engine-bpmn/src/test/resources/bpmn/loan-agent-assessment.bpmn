<?xml version="1.0" encoding="UTF-8"?>
<!-- A loan application's documents are assessed by an agent step (#52). The agent's answer must meet the output
     schema, and the bank's guardrail rule set agent-output-guardrails refuses a risk score of 70 or more; a refused
     answer goes to a compliance reviewer's four-eyes task instead of moving the loan on. The summary may quote the
     documents, so the schema marks it mask: true and the history never keeps its text. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:horus="urn:horus-bpm:bpmn:extensions:v1"
                  id="Definitions_loan-agent-assessment"
                  targetNamespace="urn:horus-bpm:examples"
                  expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:process id="loan-agent-assessment" name="Loan document assessment by an agent" isExecutable="true">
    <bpmn:startEvent id="start" name="Documents received"/>
    <bpmn:serviceTask id="assess-documents" name="Assess the documents" horus:type="agentTask"
                      horus:agent="documents.assess" horus:timeout="PT2S" horus:resultVariable="assessment">
      <bpmn:extensionElements>
        <horus:input name="applicationId" value="${instance.applicationId}"/>
        <horus:input name="requestedAmount" value="${instance.amount}"/>
        <horus:outputSchema>{
          "type": "object",
          "required": ["riskScore", "recommendation"],
          "additionalProperties": false,
          "properties": {
            "riskScore": {"type": "integer", "minimum": 0, "maximum": 100},
            "recommendation": {"type": "string", "enum": ["APPROVE", "REFER", "DECLINE"]},
            "summary": {"type": "string", "maxLength": 500, "mask": true}
          }
        }</horus:outputSchema>
        <horus:guardrail decision="agent-output-guardrails" onViolation="route-to-human"
                         reviewer="role:COMPLIANCE_REVIEWER"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="underwrite" name="Underwrite the loan" horus:assignee="role:UNDERWRITER" horus:resultVariable="decision"/>
    <bpmn:endEvent id="end" name="Decided"/>
    <bpmn:sequenceFlow id="start__assess" sourceRef="start" targetRef="assess-documents"/>
    <bpmn:sequenceFlow id="assess__underwrite" sourceRef="assess-documents" targetRef="underwrite"/>
    <bpmn:sequenceFlow id="underwrite__end" sourceRef="underwrite" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:horus="urn:horus-bpm:bpmn:extensions:v1" id="d" targetNamespace="urn:conformance" expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:process id="terminate-and-link" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:parallelGateway id="fork"/>
    <bpmn:intermediateThrowEvent id="link-out"><bpmn:linkEventDefinition name="to-finish"/></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="link-in"><bpmn:linkEventDefinition name="to-finish"/></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="stop"><bpmn:terminateEventDefinition/></bpmn:endEvent>
    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="fork"/>
    <bpmn:sequenceFlow id="f2" sourceRef="fork" targetRef="link-out"/>
    <bpmn:sequenceFlow id="f3" sourceRef="link-in" targetRef="stop"/>
    <bpmn:sequenceFlow id="f4" sourceRef="fork" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>

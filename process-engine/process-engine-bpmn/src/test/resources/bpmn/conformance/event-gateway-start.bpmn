<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:horus="urn:horus-bpm:bpmn:extensions:v1" id="d" targetNamespace="urn:conformance" expressionLanguage="urn:horus-bpm:expr:v1">
  <bpmn:message id="m-application" name="loan-application"/>
  <bpmn:signal id="s-batch" name="branch-batch-opened"/>
  <bpmn:process id="loan-intake" isExecutable="true">
    <bpmn:eventBasedGateway id="intake" instantiate="true"/>
    <bpmn:intermediateCatchEvent id="online"><bpmn:messageEventDefinition messageRef="m-application"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="branch"><bpmn:signalEventDefinition signalRef="s-batch"/></bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="route-online" scriptFormat="urn:horus-bpm:expr:v1" horus:resultVariable="route"><bpmn:script>'online'</bpmn:script></bpmn:scriptTask>
    <bpmn:scriptTask id="route-branch" scriptFormat="urn:horus-bpm:expr:v1" horus:resultVariable="route"><bpmn:script>'branch'</bpmn:script></bpmn:scriptTask>
    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="f1" sourceRef="intake" targetRef="online"/>
    <bpmn:sequenceFlow id="f2" sourceRef="intake" targetRef="branch"/>
    <bpmn:sequenceFlow id="f3" sourceRef="online" targetRef="route-online"/>
    <bpmn:sequenceFlow id="f4" sourceRef="branch" targetRef="route-branch"/>
    <bpmn:sequenceFlow id="f5" sourceRef="route-online" targetRef="end"/>
    <bpmn:sequenceFlow id="f6" sourceRef="route-branch" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>

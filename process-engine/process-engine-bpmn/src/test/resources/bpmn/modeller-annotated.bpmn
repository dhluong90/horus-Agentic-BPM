  <bpmn:process id="loan-limit-check" name="Loan limit check" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Application received">
      <bpmn:outgoing>Flow_0k3j2x1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Activity_1h8gq3c" name="Check the loan limit" horus:ruleSet="loan-limit" horus:resultVariable="limit">
      <bpmn:extensionElements>
        <horus:input name="amount" value="${instance.amount}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0k3j2x1</bpmn:incoming>
      <bpmn:outgoing>Flow_1m4n5b6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="Event_0w9e8r7" name="Limit checked">
      <bpmn:incoming>Flow_1m4n5b6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0k3j2x1" sourceRef="StartEvent_1" targetRef="Activity_1h8gq3c" />
    <bpmn:sequenceFlow id="Flow_1m4n5b6" sourceRef="Activity_1h8gq3c" targetRef="Event_0w9e8r7" />
    <bpmn:textAnnotation id="TextAnnotation_0a1b2c3">
      <bpmn:text>Limit is 500,000,000 VND for retail customers</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1d2e3f4" associationDirection="None" sourceRef="Activity_1h8gq3c" targetRef="TextAnnotation_0a1b2c3" />
    <bpmn:group id="Group_0g5h6j7" categoryValueRef="CategoryValue_1k8l9m0" />
  </bpmn:process>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:horus="urn:horus-bpm:bpmn:extensions:v1" id="d" targetNamespace="urn:t">
  <bpmn:process id="loan" isExecutable="true">
    <bpmn:startEvent id="start"/>

























    <bpmn:serviceTask id="score" camunda:class="com.example.Score" horus:handler="credit.score"/>










    <bpmn:userTask id="review" horus:resultVariable="decision"/>
    <bpmn:boundaryEvent id="be-timeout" attachedToRef="review"/>














    <bpmn:inclusiveGateway id="ig-1"/>





    <bpmn:eventBasedGateway id="notify"/>






    <bpmn:adHocSubProcess id="adhoc-1"/>














    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="score"/>
    <bpmn:sequenceFlow id="f2" sourceRef="score" targetRef="end">
      <bpmn:conditionExpression language="http://www.w3.org/1999/XPath">amount &gt; 10</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>

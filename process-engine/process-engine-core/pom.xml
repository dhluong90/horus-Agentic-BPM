<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.dhluong90.bpm</groupId>
    <artifactId>process-engine-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>
  <artifactId>process-engine-core</artifactId>
  <name>HORUS Process Engine Core</name>
  <description>Framework-free BPMN semantic model and execution kernel of the Process Engine. Depends on the JDK and, inside its internal packages only, Jackson 3.</description>
  <dependencies>
    <!--
      ADR-0027: Money, the value mapping and the expression language of gateway conditions. Not the Rule Engine:
      decisions go through the DecisionPort, which the process starter adapts when the host has a Rule Engine.
    -->
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>bpm-expression</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-no-network-client</id>
            <phase>validate</phase>
          </execution>
          <execution>
            <id>enforce-framework-free-core</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.springframework*:*</exclude>
                    <exclude>jakarta.*:*</exclude>
                    <exclude>javax.*:*</exclude>
                    <exclude>com.zaxxer:*</exclude>
                    <exclude>org.postgresql:*</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-core</exclude>
                    <exclude>com.fasterxml.jackson.dataformat:*</exclude>
                  </excludes>
                  <message>process-engine-core depends on the JDK, and Jackson 3 only (TR-EMB-03, ADR-0021).</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
          #336: sealed packages. On a class path the JVM refuses a class in these packages from any other jar or
          directory ("sealing violation"), so host code cannot reach their package-private members through a
          split package. Spring Boot's launcher keeps the check for nested jars.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
            <manifestSections>
              <manifestSection>
                <name>io/github/dhluong90/bpm/process/internal/service/</name>
                <manifestEntries>
                  <Sealed>true</Sealed>
                </manifestEntries>
              </manifestSection>
            </manifestSections>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

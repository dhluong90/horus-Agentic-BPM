<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.dhluong90.bpm</groupId>
    <artifactId>process-engine-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
  </parent>
  <artifactId>process-engine-spring-boot-starter</artifactId>
  <name>HORUS Process Engine Spring Boot Starter</name>
  <description>Auto-configures the Process Engine on the host's DataSource and transaction manager.</description>
  <dependencies>
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>process-engine-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      ADR-0027: optional. With it and a RuleEngine bean, business rule tasks evaluate through the decision port;
      without it, the Process Engine runs alone and a definition with a business rule task is refused at activation.
    -->
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>rule-engine-core</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>process-engine-bpmn</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>process-engine-postgres</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>process-engine-rest</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The host contract: the starter contributes the processes entry of /api/bpm/meta and /api/bpm/me. -->
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>bpm-host-metadata</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-core</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- The job poller health contributor, one per Spring Boot line, as in the Rule Engine starter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
      <version>${spring-boot-3.5.version}</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Decision steps on PostgreSQL with this starter's decision port (PRE-046, PRE-055, PRE-056): the storage module's
      test harness, the real Rule Engine and the test clock. Tests only.
    -->
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>process-engine-postgres</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>process-engine-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.dhluong90.bpm</groupId>
      <artifactId>rule-engine-postgres</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The agent step's PRE-009 case runs on a 2-connection host pool (AgentTaskIT). Tests only. -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
      <resource>
        <directory>${bpm.root}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>COMMERCIAL-LICENSE.md</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!--
        The decision tests on PostgreSQL run after the package phase, against the starter jar: the Rule Engine grants
        its entry point only to a decision port from a sealed jar of its own version (#336).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- This module's own jar, not target/classes (the parent's default): sealing and the version are in it. -->
          <classesDirectory>${project.build.directory}/${project.build.finalName}.jar</classesDirectory>
        </configuration>
      </plugin>
      <plugin>
        <!--
          #336: sealed package. The decision port is the registered claimant of the Rule Engine's tenant-scoped entry
          point; on a class path the JVM refuses a class in this package from any other jar or directory, so host code
          cannot define a class beside it to reach its package-private constructor.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <!-- The Rule Engine grants its entry point only to a claimant whose jar carries its own version (#336). -->
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
            <manifestSections>
              <manifestSection>
                <name>io/github/dhluong90/bpm/process/autoconfigure/</name>
                <manifestEntries>
                  <Sealed>true</Sealed>
                </manifestEntries>
              </manifestSection>
            </manifestSections>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${spring-boot.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

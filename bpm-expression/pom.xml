<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.dhluong90.bpm</groupId>
    <artifactId>bpm-parent</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>bpm-expression</artifactId>
  <name>HORUS Agentic BPM expressions</name>
  <description>Money, the Java value mapping and the expression language shared by the Process Engine and the Rule Engine. Depends on the JDK only.</description>

  <!-- ADR-0027: no compile dependency at all. No storage, no Spring, no JSON library. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!-- TR-EMB-05, TR-AGT-03: the shared list in the root POM's pluginManagement. -->
          <execution>
            <id>enforce-no-network-client</id>
            <phase>validate</phase>
          </execution>
          <!-- ADR-0027: the JDK only, in every scope that ships. -->
          <execution>
            <id>enforce-jdk-only-expression-library</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>*:*:*:*:compile</exclude>
                    <exclude>*:*:*:*:runtime</exclude>
                    <exclude>*:*:*:*:provided</exclude>
                  </excludes>
                  <message>bpm-expression depends on the JDK only (ADR-0027): no compile, runtime or provided dependency.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
